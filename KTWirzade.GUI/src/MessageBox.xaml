<controls:AcrylicWindow x:Class="KTWirzade.GUI.MessageBox"
                        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                        xmlns:local="clr-namespace:KTWirzade.GUI"
                        xmlns:controls="clr-namespace:KTWirzade.GUI.Controls"
                        mc:Ignorable="d"
                        Title="MessageBox" Height="450" Width="800">
    
    <FrameworkElement.Resources>
        <ResourceDictionary>
            <FontFamily x:Key="JetBrainsMono">/Fonts/#JetBrains Mono</FontFamily>
        </ResourceDictionary>
    </FrameworkElement.Resources>
    <StackPanel Name="MainStack" Background="{DynamicResource LicensePopupBackground}">
        <Border>
            <StackPanel>
                <TextBlock Name="TitleText" FontSize="14" Margin="27,21,27,0" FontWeight="Bold" Text="Information" Width="200" HorizontalAlignment="Left" TextTrimming="CharacterEllipsis" />
                <TextBlock VerticalAlignment="Top" Margin="0,-39,0,1" Padding="0,0,0,0" FontSize="12" LineStackingStrategy="BlockLineHeight" LineHeight="42" Text="" MouseLeftButtonDown="TitleBar_MouseDown" />
                <StackPanel Name="ContentStack">
                    <StackPanel Name="DescriptionBox" Orientation="Horizontal" Margin="0,17,0,27">
                        <TextBlock Name="DescriptionText" FontSize="13" Margin="27,0,27,0" VerticalAlignment="Center" MaxWidth="240" Text="Are you sure you want to exit the process?" TextWrapping="Wrap" TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                    <TextBox Name="MonoBox" AcceptsTab="True" TextWrapping="Wrap" Margin="10,-12,10,10" MaxHeight="165" Visibility="Collapsed" FontFamily="{StaticResource JetBrainsMono}" IsReadOnly="True" Foreground="{DynamicResource TextPrimaryBrush}">
                        <Control.Template>
                            <ControlTemplate TargetType="{x:Type TextBox}">
                                <Border Padding="3" CornerRadius="5">
                                    <Border.Background>
                                        <SolidColorBrush Color="{DynamicResource ButtonTextPrimaryColor}" Opacity="0.05" />
                                    </Border.Background>
                                    <ScrollViewer Name="PART_ContentHost" VerticalAlignment="Top" Margin="0,0,0,0" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Hidden" />
                                </Border>
                            </ControlTemplate>
                        </Control.Template>
                    </TextBox>
                </StackPanel>
            </StackPanel>
        </Border>
        <Border UseLayoutRounding="True" BorderBrush="{DynamicResource LicensePopupSeparatorBrush}" VerticalAlignment="Bottom" Height="47" Background="{DynamicResource LicensePopupLowerBrush}" BorderThickness="0,1,0,0">
            <StackPanel UseLayoutRounding="True" Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Right" Margin="0,2,13,0">
                <Button Name="MainButton" UseLayoutRounding="True" Style="{DynamicResource BlueButton}" Click="MainButton_OnClick">
                    <TextBlock Name="MainButtonText" Text="Show log" Foreground="#FFFFFFFF" FontSize="11" Margin="-4,0" />
                </Button>
                <Button Name="SecondButton" Margin="13,0,0,0" UseLayoutRounding="True" Padding="0" Width="78" Style="{DynamicResource SpecialButton}" Click="SecondButton_OnClick">
                    <TextBlock Name="SecondButtonText" Text="No" Margin="0,1,0,0" FontSize="11" />
                </Button>
            </StackPanel>
        </Border>
    </StackPanel>
    
</controls:AcrylicWindow>
