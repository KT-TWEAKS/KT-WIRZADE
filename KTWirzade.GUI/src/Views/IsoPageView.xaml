<UserControl x:Class="KTWirzade.GUI.Views.IsoPageView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:KTWirzade.GUI.Views"
             xmlns:controls="clr-namespace:KTWirzade.GUI.Controls"
             xmlns:wpf="clr-namespace:FluentIcons.Wpf;assembly=FluentIcons.Wpf"
             xmlns:gui="clr-namespace:KTWirzade.GUI"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">
    
    <Grid Name="MainGrid">
        <Grid.RowDefinitions>
            <RowDefinition Height="226" />
            <RowDefinition Height="62" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <StackPanel>
            <TextBlock Style="{DynamicResource Header}" Margin="0,0,0,13" TextTrimming="WordEllipsis" DataContext="{Binding Source={x:Static gui:GlobalsGUI.Current}}" Text="{Binding ISO.Title}" />
            <TextBlock HorizontalAlignment="Left" FontSize="13" Style="{DynamicResource InText}" Text="Create bootable media from an ISO." TextTrimming="CharacterEllipsis" Width="305" TextWrapping="Wrap" Foreground="{DynamicResource PageSubtextColor}" MaxHeight="134" DataContext="{Binding Source={x:Static gui:GlobalsGUI.Current}}" />
            <TextBlock />
            <TextBlock Name="SecondText" Grid.Row="1" VerticalAlignment="Top" Margin="0,0,0,0" FontSize="13" Style="{DynamicResource InText}" Foreground="{DynamicResource PageSubtextColor}" Text="You can write this ISO directly to one or more USB drives to create &#xD;&#xA;your own installation media." />
        </StackPanel>
        <Grid Row="1">
            <Grid Name="ModuleGrid" RenderTransformOrigin="0.5,0.5" ZIndex="1">
                <UIElement.RenderTransform>
                    <TransformGroup>
                        <ScaleTransform CenterX="3" x:Name="moduletransform" />
                    </TransformGroup>
                </UIElement.RenderTransform>
                <Border Name="RevealBox" Visibility="Hidden" VerticalAlignment="Top" Style="{DynamicResource ContentBox}" Height="47" Background="{DynamicResource NoticeBoxBrush}">
                    <Grid>
                        <StackPanel Orientation="Horizontal" DataContext="{Binding Source={x:Static gui:GlobalsGUI.Current}}">
                            <Grid Margin="1,-3,0,-2">
                                <Rectangle RadiusX="14" RadiusY="14" Width="11" Height="12" Fill="#FFFFFFFF" HorizontalAlignment="Left" Margin="4,4,0,0" VerticalAlignment="Top" />
                                <wpf:SymbolIcon wpf:SymbolIcon.Symbol="Info" TextBlock.FontSize="19" IconVariant="Filled" TextBlock.Foreground="#256eca" />
                            </Grid>
                            <TextBlock FontSize="14" Margin="15,-3,0,-2" Text="Reveal ISO file in Windows Explorer" TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                        <Button Name="RevealButton" Margin="0,-7,0,-8" Padding="13,0,13,0" Height="29" Style="{DynamicResource TransparentButton}" HorizontalAlignment="Right" Click="RevealButton_OnClick">
                            <TextBlock VerticalAlignment="Center" FontSize="14" Margin="0,0,0,1" Text="Reveal" Foreground="{DynamicResource TransparentButtonTextForeground}" />
                        </Button>
                    </Grid>
                </Border>
                <Border Name="PlaybookBox" Visibility="Hidden" VerticalAlignment="Top" Style="{DynamicResource ContentBox}" Height="47" Background="{DynamicResource NoticeBoxBrush}">
                    <Grid>
                        <StackPanel Orientation="Horizontal" DataContext="{Binding Source={x:Static gui:GlobalsGUI.Current}}">
                            <Grid Margin="1,-3,0,-2">
                                <Rectangle RadiusX="14" RadiusY="14" Width="11" Height="12" Fill="#FFFFFFFF" HorizontalAlignment="Left" Margin="4,4,0,0" VerticalAlignment="Top" />
                                <wpf:SymbolIcon wpf:SymbolIcon.Symbol="Info" TextBlock.FontSize="19" IconVariant="Filled" TextBlock.Foreground="#256eca" />
                            </Grid>
                            <TextBlock FontSize="14" Margin="15,-3,0,-2" Text="Select a Playbook to modify ISO" TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                        <Button Name="PlaybookButton" Margin="0,-7,0,-8" Padding="13,0,13,0" Height="29" Style="{DynamicResource TransparentButton}" HorizontalAlignment="Right" Click="PlaybookButton_OnClick">
                            <TextBlock VerticalAlignment="Center" FontSize="14" Margin="0,0,0,1" Text="Select" Foreground="{DynamicResource TransparentButtonTextForeground}" />
                        </Button>
                    </Grid>
                </Border>
                <Border Name="PlaybookSelectedBox" Visibility="Hidden" VerticalAlignment="Top" Style="{DynamicResource ContentBox}" Height="47" Background="{DynamicResource SuccessBoxBrush}">
                    <Grid>
                        <StackPanel Orientation="Horizontal" DataContext="{Binding Source={x:Static gui:GlobalsGUI.Current}}">
                            <Image Style="{StaticResource QualityImage}" Margin="3,-3,2,-2" Source="/Icons/checkmark_green_solid_32.png" Height="15" />
                            <TextBlock Name="PlaybookSelectedText" FontSize="14" Margin="15,-3,0,-2" Text="XXXXXX Playbook selected" TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                        <Button Name="PlaybookSelectedButton" Margin="0,-7,0,-8" Padding="13,0,13,0" Height="29" Style="{DynamicResource TransparentButton}" HorizontalAlignment="Right" Click="PlaybookSelectedCancelButton_OnClick">
                            <TextBlock VerticalAlignment="Center" FontSize="14" Margin="0,0,0,1" Text="Cancel" Foreground="{DynamicResource TransparentButtonTextForeground}" />
                        </Button>
                    </Grid>
                </Border>
                <Border Name="CompatibleBox" Visibility="Hidden" VerticalAlignment="Top" Style="{DynamicResource ContentBox}" Height="47" Background="{DynamicResource SuccessBoxBrush}">
                    <Grid>
                        <StackPanel Orientation="Horizontal" DataContext="{Binding Source={x:Static gui:GlobalsGUI.Current}}">
                            <Image Style="{StaticResource QualityImage}" Margin="3,-3,2,-2" Source="/Icons/checkmark_green_solid_32.png" Height="15" />
                            <TextBlock Name="CompatibleText" FontSize="14" Margin="15,-3,0,-2" Text="Compatible flash drive selected" TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <Button Name="CompatibleCancelButton" Margin="0,-7,0,-8" Padding="13,0,13,0" Height="29" Style="{DynamicResource TransparentButton}" Click="CompatibleCancelButton_OnClick">
                                <TextBlock VerticalAlignment="Center" FontSize="14" Margin="0,0,0,1" Text="Cancel" Foreground="{DynamicResource TransparentButtonTextForeground}" />
                            </Button>
                        </StackPanel>
                    </Grid>
                </Border>
                <Border Name="UsbDisconnectedBox" Visibility="Hidden" VerticalAlignment="Top" Style="{DynamicResource ContentBox}" Height="47" Background="{DynamicResource WarningBoxBrush}">
                    <Grid>
                        <StackPanel Orientation="Horizontal" DataContext="{Binding Source={x:Static gui:GlobalsGUI.Current}}">
                            <Grid Margin="1,-3,0,-2">
                                <Rectangle RadiusX="14" RadiusY="14" Width="11" Height="12" Fill="{DynamicResource YellowInfoCircleSymbol}" HorizontalAlignment="Left" Margin="4,4,0,0" VerticalAlignment="Top" />
                                <wpf:SymbolIcon wpf:SymbolIcon.Symbol="Info" TextBlock.FontSize="19" IconVariant="Filled" TextBlock.Foreground="{DynamicResource YellowInfoCircleFill}" />
                            </Grid>
                            <TextBlock Name="UsbDisconnectedText" FontSize="14" Margin="15,-3,0,-2" Text="A target USB drive was unplugged" TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <Button Name="DismissUsbDisconnectedButton" Margin="0,-7,0,-8" Padding="13,0,13,0" Height="29" Style="{DynamicResource TransparentButton}" Click="DismissUsbDisconnectedButton_OnClick">
                                <TextBlock VerticalAlignment="Center" FontSize="14" Margin="0,0,0,1" Text="Dismiss" Foreground="{DynamicResource TransparentButtonTextForeground}" />
                            </Button>
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>
            <StackPanel ZIndex="2">
                <Border Name="WriteBox" Style="{DynamicResource ContentBox}" Height="62">
                    <Grid>
                        <StackPanel Name="WriteStack" HorizontalAlignment="Left" Orientation="Horizontal">
                            <Image Style="{StaticResource QualityImage}" Margin="0,1,0,0" Source="{DynamicResource UsbDrive32}" Width="32" VerticalAlignment="Center" HorizontalAlignment="Left" />
                            <StackPanel Margin="8,-3,0,-2">
                                <TextBlock FontSize="15" Text="Write ISO" Foreground="{DynamicResource TextSoftBrush}" Margin="0,-1,0,0" />
                                <TextBlock Foreground="{DynamicResource TextSecondaryBrush}" FontSize="13" Text="Make a bootable USB stick" />
                            </StackPanel>
                        </StackPanel>
                        <Button Name="WriteButton" Margin="0,-2,0,-2" Padding="24,0,24,0" Style="{DynamicResource ContentBoxButton}" HorizontalAlignment="Right" Click="WriteButton_OnClick">
                            <TextBlock VerticalAlignment="Center" FontSize="14" Margin="0,0,0,1" Text="Select drive" />
                        </Button>
                    </Grid>
                </Border>
            </StackPanel>
        </Grid>
        <TextBlock Name="ClickSelectText" Grid.Row="2" VerticalAlignment="Bottom" FontSize="14" Foreground="{DynamicResource PageSubtextColor}">Click the <Bold>Select drive</Bold> button above to continue.</TextBlock>
        <TextBlock Name="ClickNextText" Grid.Row="2" VerticalAlignment="Bottom" FontSize="14" Visibility="Collapsed" Foreground="{DynamicResource PageSubtextColor}">Click the <Bold>Next</Bold> button below to continue.</TextBlock>
        <Popup Name="SelectPopup" Grid.RowSpan="2" Grid.Row="0" UseLayoutRounding="True" Width="700" Height="490" VerticalOffset="-490" IsOpen="False" StaysOpen="True" PopupAnimation="Fade" AllowsTransparency="True" PlacementTarget="{Binding RelativeSource={RelativeSource AncestorType=Window}}" MouseLeftButtonDown="FocusWindow">
            <Border UseLayoutRounding="True" Padding="132,42,133,44" CornerRadius="{DynamicResource PopupCornerRadius}" Background="#44000000">
                <Border UseLayoutRounding="True" Width="365" Height="323" CornerRadius="9" BorderThickness="1" BorderBrush="{DynamicResource LicensePopupBorder}" Background="{DynamicResource LicensePopupBackground}">
                    <UIElement.Effect>
                        <DropShadowEffect ShadowDepth="0" BlurRadius="40" Opacity="0.27" />
                    </UIElement.Effect>
                    <StackPanel>
                        <UIElement.Clip>
                            <RectangleGeometry Rect="0,0,363,1000" />
                        </UIElement.Clip>
                        <Grid Name="MainContainerGrid" HorizontalAlignment="Left" Margin="0,0,0,0">
                            <StackPanel Margin="27,18,26,0" Height="252">
                                <TextBlock FontSize="16" FontWeight="Bold" Text="Select Playbook" />
                                <TextBlock FontSize="13" HorizontalAlignment="Left" Width="268" Margin="0,21,0,0" Text="Select a compatible Playbook to apply to this ISO. You can then create USB boot media." TextWrapping="Wrap" />
                                <TextBlock Name="TopLineBlock" Margin="0,10,0,0" Visibility="Visible" Text="Only compatible Playbooks will appear here." FontSize="13" TextTrimming="CharacterEllipsis" Foreground="{DynamicResource TextSecondaryBrush}" />
                                <StackPanel Name="SelectPlaybookStack" Margin="0,31,0,0" Orientation="Horizontal" UseLayoutRounding="True">
                                    <Grid Name="DragBoxContainer" Margin="0,0,0,10">
                                        <Button Name="DragBox" UseLayoutRounding="False" Style="{DynamicResource DragBoxSmall}" Opacity="0.75" Click="DragBox_OnClick" Drop="DragBox_OnDrop" />
                                        <Grid Name="PBLoadContainer" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed" Width="25" Height="25" Margin="0,-3,0,0" />
                                    </Grid>
                                </StackPanel>
                            </StackPanel>
                        </Grid>
                        <Border Margin="0,2,0,0" UseLayoutRounding="True" CornerRadius="0,0,7,7" BorderBrush="{DynamicResource LicensePopupSeparatorBrush}" Height="47" Background="{DynamicResource LicensePopupLowerBrush}" BorderThickness="0,1,0,0">
                            <StackPanel UseLayoutRounding="True" Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Right" Margin="0,2,13,0">
                                <Button Name="SelectSelectButton" UseLayoutRounding="True" Style="{DynamicResource BlueButton}" Margin="0,0,13,0" Click="SelectSelectButton_OnClick">
                                    <TextBlock Name="NextText" Text="Select" Foreground="#FFFFFFFF" FontSize="11" Margin="-3,0,-3,0" />
                                </Button>
                                <Button Name="SelectCancelButton" UseLayoutRounding="True" Padding="0" Width="78" Style="{DynamicResource SpecialButton}" Click="SelectCancelButton_OnClick">
                                    <TextBlock Text="Cancel" Margin="0,1,0,0" FontSize="11" />
                                </Button>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Border>
            </Border>
        </Popup>
        <Popup Name="UsbPopup" Grid.RowSpan="2" Grid.Row="0" UseLayoutRounding="True" Width="700" Height="490" VerticalOffset="-490" IsOpen="False" StaysOpen="True" PopupAnimation="Fade" AllowsTransparency="True" PlacementTarget="{Binding RelativeSource={RelativeSource AncestorType=Window}}" MouseLeftButtonDown="FocusWindow">
            <UIElement.CommandBindings>
                <CommandBinding Command="{x:Static local:IsoPageView.RefreshCommand}" Executed="RefreshCommand_OnExecuted" />
            </UIElement.CommandBindings>
            <Border UseLayoutRounding="True" Padding="132,42,133,44" CornerRadius="{DynamicResource PopupCornerRadius}" Background="#44000000">
                <Border UseLayoutRounding="True" Width="365" Height="323" CornerRadius="9" BorderThickness="1" BorderBrush="{DynamicResource LicensePopupBorder}" Background="{DynamicResource LicensePopupBackground}">
                    <UIElement.Effect>
                        <DropShadowEffect ShadowDepth="0" BlurRadius="40" Opacity="0.27" />
                    </UIElement.Effect>
                    <StackPanel>
                        <UIElement.Clip>
                            <RectangleGeometry Rect="0,0,363,1000" />
                        </UIElement.Clip>
                        <Grid Name="UsbMainContainerGrid" HorizontalAlignment="Left" Margin="0,0,0,0" VerticalAlignment="Stretch">
                            <Grid Margin="27,18,26,0" Height="252" VerticalAlignment="Stretch">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>
                                <StackPanel>
                                    <TextBlock FontSize="16" FontWeight="Bold" Text="Select flash Media" />
                                    <TextBlock Name="UsbHoldShiftText" Margin="0,21,0,14" Visibility="Collapsed" Text="Hold down SHIFT to select up to 5 drives." FontSize="13" TextTrimming="CharacterEllipsis" Foreground="{DynamicResource TextSecondaryBrush}" />
                                    <StackPanel Name="UsbTextStack" Margin="0,0,0,35">
                                        <TextBlock FontSize="13" HorizontalAlignment="Left" Width="285" Margin="0,21,0,0" Text="Select a USB stick or SD card to write the bootable ISO file to. The drive will be formatted." TextWrapping="Wrap" />
                                        <TextBlock Name="TopUsbLineBlock" Margin="0,10,0,0" Visibility="Visible" Text="The drive needs to be 8 GB or larger in size." FontSize="13" TextTrimming="CharacterEllipsis" Foreground="{DynamicResource TextSecondaryBrush}" />
                                    </StackPanel>
                                </StackPanel>
                                <Grid Row="1" VerticalAlignment="Stretch">
                                    <Grid Name="UsbLoadContainer" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed" Width="25" Height="25" Margin="0,-3,0,0" />
                                    <ScrollViewer Name="UsbScrollViewer" VerticalAlignment="Stretch" VerticalScrollBarVisibility="Disabled" HorizontalScrollBarVisibility="Disabled">
                                        <StackPanel Name="UsbStack" />
                                    </ScrollViewer>
                                    <Border Name="UsbHideBorder" VerticalAlignment="Bottom" Background="{DynamicResource LicensePopupBackground}" Height="42">
                                        <Button UseLayoutRounding="True" Padding="0" Width="78" HorizontalAlignment="Left" VerticalAlignment="Center" Style="{DynamicResource SpecialButton}" IsEnabled="True" Click="UsbShowAllButton_OnClick">
                                            <TextBlock Text="Show all" Margin="0,1,0,0" FontSize="11" />
                                        </Button>
                                    </Border>
                                </Grid>
                            </Grid>
                        </Grid>
                        <Border Margin="0,2,0,0" UseLayoutRounding="True" CornerRadius="0,0,7,7" BorderBrush="{DynamicResource LicensePopupSeparatorBrush}" Height="47" Background="{DynamicResource LicensePopupLowerBrush}" BorderThickness="0,1,0,0">
                            <StackPanel UseLayoutRounding="True" Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Right" Margin="0,2,13,0">
                                <Button Name="UsbSelectSelectButton" UseLayoutRounding="True" Style="{DynamicResource BlueButton}" Margin="0,0,13,0" Click="UsbSelectSelectButton_OnClick">
                                    <TextBlock Name="UsbNextText" Text="Select" Foreground="#FFFFFFFF" FontSize="11" Margin="-3,0,-3,0" IsEnabled="False" />
                                </Button>
                                <Button Name="UsbSelectCancelButton" UseLayoutRounding="True" Padding="0" Width="78" Style="{DynamicResource SpecialButton}" IsEnabled="False" Click="SelectCancelButton_OnClick">
                                    <TextBlock Text="Cancel" Margin="0,1,0,0" FontSize="11" />
                                </Button>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Border>
            </Border>
        </Popup>
    </Grid>
</UserControl>
