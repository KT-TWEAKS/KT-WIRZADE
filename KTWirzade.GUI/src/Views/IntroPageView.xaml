<UserControl x:Class="KTWirzade.GUI.Views.IntroPageView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:KTWirzade.GUI.Views"
             xmlns:controls="clr-namespace:KTWirzade.GUI.Controls"
             xmlns:wpf="clr-namespace:FluentIcons.Wpf;assembly=FluentIcons.Wpf"
             xmlns:gui="clr-namespace:KTWirzade.GUI"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">
    
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <StackPanel Margin="0,10,0,0">
            <TextBlock Style="{DynamicResource Header}" Margin="0,0,0,13" TextTrimming="WordEllipsis" DataContext="{Binding Source={x:Static gui:GlobalsGUI.Current}}" Text="{Binding Playbook.Title}" />
            <ScrollViewer MaxHeight="134" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <ScrollViewer.Resources>
                    <Style TargetType="{x:Type ScrollBar}" BasedOn="{StaticResource SidebarScrollBar}" />
                </ScrollViewer.Resources>
                <TextBlock HorizontalAlignment="Stretch" MaxWidth="650" FontSize="13" Style="{DynamicResource InText}" TextWrapping="Wrap" Foreground="{DynamicResource PageSubtextColor}" DataContext="{Binding Source={x:Static gui:GlobalsGUI.Current}}" Text="{Binding Playbook.Description, StringFormat={}{0}}" />
            </ScrollViewer>
            <TextBlock Name="NextStepText" VerticalAlignment="Top" Margin="0,10,0,0" FontSize="13" Style="{DynamicResource InText}" Foreground="{DynamicResource PageSubtextColor}" Text="O próximo passo verificará se o sistema atende&#xD;&#xA;aos requisitos para continuar." />
            <Border Name="VerificationUnavailableBox" Visibility="Collapsed" Margin="0,10,0,0" Padding="10,8" CornerRadius="6" Background="{DynamicResource StatusWarningSoftBrush}" BorderThickness="1" BorderBrush="{DynamicResource StatusWarningBrush}">
                <StackPanel Orientation="Horizontal">
                    <wpf:SymbolIcon Symbol="CloudOff" FontSize="16" Margin="0,0,9,0" VerticalAlignment="Center" TextBlock.Foreground="{DynamicResource StatusWarningBrush}" />
                    <TextBlock FontSize="11" Foreground="{DynamicResource TextPrimaryBrush}" TextWrapping="Wrap" VerticalAlignment="Center" Text="Verificação online indisponível. O APBX continua salvo neste computador, mas sua origem não foi confirmada. Revise o arquivo e use apenas se confiar na fonte." />
                </StackPanel>
            </Border>
        </StackPanel>
        <Grid Grid.Row="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Grid Name="ModuleGrid" Grid.Row="0" RenderTransformOrigin="0.5,0.5" ZIndex="1">
                <UIElement.RenderTransform>
                    <TransformGroup>
                        <ScaleTransform CenterX="3" x:Name="moduletransform" />
                        <TranslateTransform x:Name="moduleTranslate" Y="8" />
                    </TransformGroup>
                </UIElement.RenderTransform>
                <Border Name="NotRequiredBox" Visibility="Collapsed" VerticalAlignment="Top" Style="{DynamicResource ContentBox}" Height="47" Background="{DynamicResource NoticeBoxBrush}">
                    <StackPanel Orientation="Horizontal" DataContext="{Binding Source={x:Static gui:GlobalsGUI.Current}}">
                        <Grid Margin="1,-3,0,-2">
                            <Rectangle RadiusX="14" RadiusY="14" Width="11" Height="12" Fill="#FFFFFFFF" HorizontalAlignment="Left" Margin="4,4,0,0" VerticalAlignment="Top" />
                            <wpf:SymbolIcon wpf:SymbolIcon.Symbol="Info" TextBlock.FontSize="19" IconVariant="Filled" TextBlock.Foreground="#256eca" />
                        </Grid>
                        <TextBlock FontSize="14" Margin="15,-3,0,-2" MaxWidth="130" TextTrimming="CharacterEllipsis" Text="{Binding Playbook.Name}" />
                        <TextBlock FontSize="14" Margin="0,-3,0,-2" Text=" não exige segurança desativada" />
                    </StackPanel>
                </Border>
                <Border Name="AntivirusBox" Visibility="Collapsed" VerticalAlignment="Top" Style="{DynamicResource ContentBox}" Height="47" Background="{DynamicResource NoticeBoxBrush}">
                    <Grid>
                        <StackPanel Orientation="Horizontal" DataContext="{Binding Source={x:Static gui:GlobalsGUI.Current}}">
                            <Grid Margin="1,-3,0,-2">
                                <Rectangle RadiusX="14" RadiusY="14" Width="11" Height="12" Fill="#FFFFFFFF" HorizontalAlignment="Left" Margin="4,4,0,0" VerticalAlignment="Top" />
                                <wpf:SymbolIcon wpf:SymbolIcon.Symbol="Info" TextBlock.FontSize="19" IconVariant="Filled" TextBlock.Foreground="#256eca" />
                            </Grid>
                            <TextBlock FontSize="14" Margin="15,-3,0,-2" Text="Remova o antivirus de terceiros" TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                        <Button Name="AntivirusButton" Margin="0,-7,0,-8" Padding="13,0,13,0" Height="29" Style="{DynamicResource TransparentButton}" HorizontalAlignment="Right" Click="AntivirusButton_OnClick">
                            <TextBlock Name="AntivirusActionText" VerticalAlignment="Center" FontSize="14" Margin="0,0,0,1" Text="Executar ação" Foreground="{DynamicResource TransparentButtonTextForeground}" />
                        </Button>
                    </Grid>
                </Border>
                <Border Name="AppliedBox" Visibility="Collapsed" VerticalAlignment="Top" Style="{DynamicResource ContentBox}" Height="47" Background="{DynamicResource SuccessBoxBrush}">
                    <Grid>
                        <StackPanel Orientation="Horizontal" DataContext="{Binding Source={x:Static gui:GlobalsGUI.Current}}">
                            <Image Style="{StaticResource QualityImage}" Margin="3,-3,2,-2" Source="/Icons/checkmark_green_solid_32.png" Height="15" />
                            <TextBlock Name="AppliedText" FontSize="14" Margin="15,-3,0,-2" Text="Este playbook ja esta aplicado" TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <Grid Name="AppliedLoadContainer" HorizontalAlignment="Right" Visibility="Collapsed" Width="16" Height="16" Margin="0,0,4,0" />
                            <Button Name="RunAgainButton" Margin="0,-7,0,-8" Padding="13,0,13,0" Height="29" Style="{DynamicResource TransparentButton}" Click="RunAgainButton_OnClick" Cursor="Hand">
                                <TextBlock Name="RunAgainText" VerticalAlignment="Center" FontSize="14" Margin="0,0,0,1" Text="Executar novamente" Foreground="{DynamicResource TransparentButtonTextForeground}" />
                            </Button>
                        </StackPanel>
                    </Grid>
                </Border>
                <Border Name="AppliedErrorBox" Visibility="Collapsed" VerticalAlignment="Top" Style="{DynamicResource ContentBox}" Height="47" Background="{DynamicResource WarningBoxBrush}">
                    <Grid>
                        <StackPanel Orientation="Horizontal" DataContext="{Binding Source={x:Static gui:GlobalsGUI.Current}}">
                            <Grid Margin="1,-3,0,-2">
                                <Rectangle RadiusX="14" RadiusY="14" Width="11" Height="12" Fill="{DynamicResource YellowInfoCircleSymbol}" HorizontalAlignment="Left" Margin="4,4,0,0" VerticalAlignment="Top" />
                                <wpf:SymbolIcon wpf:SymbolIcon.Symbol="Info" TextBlock.FontSize="19" IconVariant="Filled" TextBlock.Foreground="{DynamicResource YellowInfoCircleFill}" />
                            </Grid>
                            <TextBlock Name="AppliedErrorBoxText" FontSize="14" Margin="15,-3,0,-2" Text="Este playbook foi aplicado com erros" TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <Grid Name="AppliedErrorLoadContainer" HorizontalAlignment="Right" Visibility="Collapsed" Width="16" Height="16" Margin="0,0,4,0" />
<Button Name="RunAgainErrorButton" Margin="0,-7,0,-8" Padding="13,0,13,0" Height="29" Style="{DynamicResource TransparentButton}" Click="RunAgainButton_OnClick" Cursor="Hand">
                                <TextBlock Name="RunAgainErrorText" VerticalAlignment="Center" FontSize="14" Margin="0,0,0,1" Text="Executar novamente" Foreground="{DynamicResource TransparentButtonTextForeground}" />
                           </Button>
                        </StackPanel>
                    </Grid>
                </Border>
                <Border Name="UpgradeBox" Visibility="Collapsed" VerticalAlignment="Top" Style="{DynamicResource ContentBox}" Height="47" Background="{DynamicResource SuccessBoxBrush}">
                    <Grid>
                        <StackPanel Orientation="Horizontal">
                            <Image Style="{StaticResource QualityImage}" Margin="3,-3,2,-2" Source="/Icons/checkmark_green_solid_32.png" Height="15" />
                            <TextBlock Name="UpgradeText" FontSize="14" Margin="15,-3,0,-2" Text="Este playbook ja esta aplicado" TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <Grid Name="UpgradeLoadContainer" HorizontalAlignment="Right" Visibility="Collapsed" Width="16" Height="16" Margin="0,0,4,0" />
                            <Button Name="UpgradeButton" Margin="0,-7,0,-8" Padding="13,0,13,0" Height="29" Style="{DynamicResource TransparentButton}" Click="RunAgainButton_OnClick" Cursor="Hand">
                                <TextBlock Name="UpgradeActionText" VerticalAlignment="Center" FontSize="14" Margin="0,0,0,1" Text="Atualizar" Foreground="{DynamicResource TransparentButtonTextForeground}" />
                            </Button>
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>
            <StackPanel Grid.Row="1" Margin="0,8,0,0" ZIndex="2">
                <Border Name="DefenderBox" Visibility="Collapsed" Style="{DynamicResource ContentBox}" Height="62">
                    <Grid>
                        <StackPanel Name="DisableSecurityStack" HorizontalAlignment="Left" Orientation="Horizontal">
                            <Image Style="{StaticResource QualityImage}" Margin="6,1,0,0" Source="{DynamicResource ShieldDots32}" Width="18" VerticalAlignment="Center" HorizontalAlignment="Left" />
                            <StackPanel Margin="22,-3,0,-2">
                            <TextBlock Name="SecurityActionTitle" FontSize="15" Text="Desativar segurança" Foreground="{DynamicResource TextSoftBrush}" Margin="0,-1,0,0" />
                                <TextBlock Name="SecurityActionDescription" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="13" Text="Permitir acesso ao sistema de arquivos do KT WIRZADE" />
                            </StackPanel>
                        </StackPanel>
                        <Button Name="DisableSecurityButton" Margin="0,-2,0,-2" Padding="24,0,24,0" Style="{DynamicResource ContentBoxButton}" HorizontalAlignment="Right" Click="Run_OnClick">
                            <TextBlock Name="SecurityActionText" VerticalAlignment="Center" FontSize="14" Margin="0,0,0,1" Text="Executar ação" />
                        </Button>
                    </Grid>
                </Border>
            </StackPanel>
            <Border Name="OverrideBox" Grid.Row="2" Visibility="Collapsed" Margin="0,8,0,0" Padding="12,9" CornerRadius="6" Background="{DynamicResource WarningBoxBrush}" BorderThickness="1" BorderBrush="{DynamicResource StatusWarningBrush}">
                <StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <wpf:SymbolIcon wpf:SymbolIcon.Symbol="Warning" FontSize="15" Margin="0,0,8,0" VerticalAlignment="Center" TextBlock.Foreground="{DynamicResource StatusWarningBrush}" />
                        <TextBlock Name="OverrideWarningText" FontSize="12" TextWrapping="Wrap" VerticalAlignment="Center" Foreground="{DynamicResource TextPrimaryBrush}" Text="Remova o antivírus de terceiros para continuar." />
                    </StackPanel>
                    <CheckBox Name="OverrideAcceptBox" Margin="0,7,0,0" FontSize="12" Foreground="{DynamicResource TextPrimaryBrush}" Content="Entendo os riscos e desejo continuar mesmo assim" Checked="OverrideAcceptBox_OnChecked" Unchecked="OverrideAcceptBox_OnUnchecked" />
                    <Grid Margin="0,4,0,0">
                        <TextBlock Name="OverrideBadgeText" Visibility="Collapsed" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource StatusWarningBrush}" VerticalAlignment="Center" Text="1 verificação ignorada pelo usuário" />
                        <Button Name="OverrideRecheckButton" HorizontalAlignment="Right" Margin="0,-2,0,-2" Padding="13,0,13,0" Height="26" Style="{DynamicResource TransparentButton}" Click="OverrideRecheckButton_OnClick">
                            <TextBlock Name="OverrideRecheckText" VerticalAlignment="Center" FontSize="12" Margin="0,0,0,1" Text="Verificar novamente" Foreground="{DynamicResource TransparentButtonTextForeground}" />
                        </Button>
                    </Grid>
                </StackPanel>
            </Border>
        </Grid>
        <TextBlock Name="FooterGuidanceText" Grid.Row="2" Margin="0,0,125,0" VerticalAlignment="Bottom" FontSize="14" Foreground="{DynamicResource PageSubtextColor}" TextWrapping="Wrap" Text="Clique em “Avançar” para verificar os requisitos." />
        <TextBlock Grid.Row="2" VerticalAlignment="Bottom" HorizontalAlignment="Right" Margin="0,0,10,10" FontSize="10" Foreground="{DynamicResource TextSecondaryBrush}" Opacity="0.7">modificado por kelvenapk</TextBlock>
        <Popup Name="ConflictPopup" Grid.RowSpan="2" Grid.Row="0" UseLayoutRounding="True" Width="700" Height="490" VerticalOffset="-490" IsOpen="False" StaysOpen="True" PopupAnimation="Fade" AllowsTransparency="True" PlacementTarget="{Binding RelativeSource={RelativeSource AncestorType=Window}}" MouseLeftButtonDown="FocusWindow">
            <Border UseLayoutRounding="True" Padding="132,42,133,44" CornerRadius="{DynamicResource PopupCornerRadius}" Background="#44000000">
                <Border UseLayoutRounding="True" Width="365" Height="323" CornerRadius="9" BorderThickness="1" BorderBrush="{DynamicResource LicensePopupBorder}" Background="{DynamicResource LicensePopupBackground}">
                    <UIElement.Effect>
                        <DropShadowEffect ShadowDepth="0" BlurRadius="40" Opacity="0.27" />
                    </UIElement.Effect>
                    <StackPanel>
                        <UIElement.Clip>
                            <RectangleGeometry Rect="0,0,363,1000" />
                        </UIElement.Clip>
                        <Grid Name="MainContainerGrid" HorizontalAlignment="Left" Margin="0,0,0,0">
                            <StackPanel Margin="27,18,26,0" Height="252">
                                <TextBlock FontSize="16" FontWeight="Bold" Text="Playbooks conflitantes" />
                                <TextBlock Name="ConflictPopupText" FontSize="13" HorizontalAlignment="Left" Width="268" Margin="0,21,0,0" Text="Ja existe um playbook de conversao total aplicado no sistema. Continuar mesmo assim?" TextWrapping="Wrap" />
                                <TextBlock Name="ConflictTopLine" Margin="0,10,0,0" Visibility="Visible" Text="Isso pode causar grandes conflitos e problemas!" FontSize="13" TextTrimming="CharacterEllipsis" Foreground="{DynamicResource TextSecondaryBrush}" />
                                <StackPanel Margin="0,31,0,0" Orientation="Horizontal">
                                    <Border CornerRadius="5" Height="72" Width="74" VerticalAlignment="Top" Margin="0,2,0,0">
                                        <Border.Background>
                                            <SolidColorBrush Color="{DynamicResource ButtonTextPrimaryColor}" Opacity="0.025" />
                                        </Border.Background>
                                        <StackPanel>
                                            <Image Name="ConflictCurrentImage" Style="{StaticResource QualityImage}" Height="35" VerticalAlignment="Top" Margin="0,8,0,0" />
                                            <TextBlock Name="ConflictCurrentTitle" Margin="0,5,0,0" Text="KT WIRZADE 11" TextTrimming="CharacterEllipsis" HorizontalAlignment="Center" Width="72" TextAlignment="Center" />
                                        </StackPanel>
                                    </Border>
                                    <StackPanel Margin="12,27,9,0" VerticalAlignment="Top">
                                        <StackPanel Orientation="Horizontal">
                                            <Rectangle Fill="#FFFF0000" Width="37" Height="1" />
                                            <Polygon Points="0,0 3.4,1.5625 0,3.125" Margin="0,1,0,0" Stroke="#c32b1d" Fill="#c32b1d" RenderTransformOrigin="0.5,0.5">
                                                <UIElement.RenderTransform>
                                                    <TranslateTransform Y="-0.2" />
                                                </UIElement.RenderTransform>
                                            </Polygon>
                                        </StackPanel>
                                        <wpf:SymbolIcon wpf:SymbolIcon.Symbol="Warning" FrameworkElement.Margin="-2,6,0,0" TextBlock.Foreground="#c32b1d" TextBlock.FontSize="22" />
                                    </StackPanel>
                                    <Grid HorizontalAlignment="Left" VerticalAlignment="Top">
                                        <Border Margin="2" Height="72" CornerRadius="5" VerticalAlignment="Top">
                                            <Border.Background>
                                                <SolidColorBrush Color="Red" Opacity="0.085" />
                                            </Border.Background>
                                            <StackPanel>
                                                <Image Name="ConflictImage" Style="{StaticResource QualityImage}" Height="35" VerticalAlignment="Top" Margin="0,8,0,0" />
                                                <TextBlock Name="ConflictTitle" Margin="0,5,0,0" Text="Slimit10 LT" TextTrimming="CharacterEllipsis" HorizontalAlignment="Center" Width="72" TextAlignment="Center" />
                                            </StackPanel>
                                        </Border>
                                        <Grid Name="OverlayContainer" VerticalAlignment="Top" Height="76" Width="78" Opacity="1">
                                            <Border BorderBrush="{DynamicResource LicensePopupBackground}" BorderThickness="1" Margin="2" CornerRadius="1" />
                                            <Border Name="RedBorder" BorderBrush="#c32b1d" BorderThickness="2" CornerRadius="4">
                                                <Border BorderBrush="{DynamicResource LicensePopupBackground}" BorderThickness="1" CornerRadius="3" />
                                            </Border>
                                        </Grid>
                                    </Grid>
                                </StackPanel>
                            </StackPanel>
                        </Grid>
                        <Border Margin="0,2,0,0" UseLayoutRounding="True" CornerRadius="0,0,7,7" BorderBrush="{DynamicResource LicensePopupSeparatorBrush}" Height="47" Background="{DynamicResource LicensePopupLowerBrush}" BorderThickness="0,1,0,0">
                            <StackPanel UseLayoutRounding="True" Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Right" Margin="0,2,13,0">
                                <Button Name="ConflictCancelButton" Margin="0,0,13,0" UseLayoutRounding="True" Style="{DynamicResource BlueButton}" Click="ConflictCancelButton_OnClick">
                                    <TextBlock Text="Cancel" Foreground="#FFFFFFFF" FontSize="11" />
                                </Button>
                                <Button Name="ConflictContinueButton" UseLayoutRounding="True" Padding="0" Width="78" Style="{DynamicResource SpecialButton}" Click="ConflictContinueButton_OnClick">
                                    <TextBlock Name="NextText" Text="Continue" FontSize="11" Margin="-3,1,-3,0" />
                                </Button>
                                <Button Name="ConflictOKButton" Visibility="Collapsed" UseLayoutRounding="True" Style="{DynamicResource BlueButton}" Margin="0,0,13,0" Click="ConflictCancelButton_OnClick">
                                    <TextBlock Text="OK" Foreground="#FFFFFFFF" FontSize="11" Margin="-3,0,-3,0" />
                                </Button>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Border>
            </Border>
        </Popup>
        <Popup Name="Popup" Grid.RowSpan="2" Grid.Row="0" UseLayoutRounding="True" Width="700" Height="490" VerticalOffset="-490" IsOpen="False" StaysOpen="True" PopupAnimation="Fade" AllowsTransparency="True" PlacementTarget="{Binding RelativeSource={RelativeSource AncestorType=Window}}" MouseLeftButtonDown="FocusWindow">
            <Border UseLayoutRounding="True" Padding="132,126,133,128" CornerRadius="{DynamicResource PopupCornerRadius}" Background="#44000000">
                <Border UseLayoutRounding="True" Width="365" Height="176" CornerRadius="9" BorderThickness="1" BorderBrush="{DynamicResource LicensePopupBorder}" Background="{DynamicResource LicensePopupBackground}">
                    <UIElement.Effect>
                        <DropShadowEffect ShadowDepth="0" BlurRadius="40" Opacity="0.27" />
                    </UIElement.Effect>
                    <StackPanel>
                        <StackPanel Margin="27,18,85,0" Height="105">
                            <TextBlock Name="UpdatesPopupTitle" FontSize="16" FontWeight="Bold" Text="Atualizacoes disponiveis" />
                            <TextBlock Name="UpdatesPopupText" FontSize="13" Margin="0,21,0,25" Text="Existem atualizacoes para este playbook e para o KT WIRZADE." TextWrapping="Wrap" />
                        </StackPanel>
                        <Border Margin="0,2,0,0" UseLayoutRounding="True" CornerRadius="0,0,7,7" BorderBrush="{DynamicResource LicensePopupSeparatorBrush}" Height="47" Background="{DynamicResource LicensePopupLowerBrush}" BorderThickness="0,1,0,0">
                            <StackPanel UseLayoutRounding="True" Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Right" Margin="0,2,13,0">
                                <Button UseLayoutRounding="True" Style="{DynamicResource BlueButton}" Margin="0,0,13,0" Click="OpenUpdates">
                                    <TextBlock Text="Ver" Foreground="#FFFFFFFF" FontSize="11" Margin="0" />
                                </Button>
                                <Button UseLayoutRounding="True" Padding="0" Width="78" Style="{DynamicResource SpecialButton}" Click="Continue">
                                    <TextBlock Text="Continue" Margin="0,1,0,0" FontSize="11" />
                                </Button>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Border>
            </Border>
        </Popup>
    </Grid>
</UserControl>
