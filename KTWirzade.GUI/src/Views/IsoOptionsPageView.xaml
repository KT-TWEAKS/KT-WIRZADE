<UserControl x:Class="KTWirzade.GUI.Views.IsoOptionsPageView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:KTWirzade.GUI.Views"
             xmlns:wpf="clr-namespace:FluentIcons.Wpf;assembly=FluentIcons.Wpf"
             xmlns:controls="clr-namespace:KTWirzade.GUI.Controls"
             xmlns:pages="clr-namespace:KTWirzade.GUI.Pages.IsoModePage"
             xmlns:gui="clr-namespace:KTWirzade.GUI"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="226" />
            <RowDefinition Height="62" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <StackPanel>
            <TextBlock Style="{DynamicResource Header}" Margin="0,0,0,13" TextTrimming="WordEllipsis" DataContext="{Binding Source={x:Static gui:GlobalsGUI.Current}}" Text="{Binding ISO.Title}" />
            <TextBlock HorizontalAlignment="Left" FontSize="13" Style="{DynamicResource InText}" Text="All requirements met to write ISO image&#xD;&#xA;&#xD;&#xA;The length of this process can vary based on your system&quot;s SSD and I/O performance, but should not take any longer than 10 minutes in most cases." TextTrimming="CharacterEllipsis" Width="390" TextWrapping="Wrap" Foreground="{DynamicResource PageSubtextColor}" MaxHeight="130" DataContext="{Binding Source={x:Static gui:GlobalsGUI.Current}}" />
        </StackPanel>
        <Grid Row="1">
            <Grid Name="ModuleGrid" RenderTransformOrigin="0.5,0.5" ZIndex="1">
                <UIElement.RenderTransform>
                    <TransformGroup>
                        <ScaleTransform CenterX="3" x:Name="moduletransform" />
                    </TransformGroup>
                </UIElement.RenderTransform>
                <Border Name="DefaultBox" Visibility="Hidden" VerticalAlignment="Top" Style="{DynamicResource ContentBox}" Height="47" Background="{DynamicResource NoticeBoxBrush}">
                    <Grid>
                        <StackPanel UseLayoutRounding="True" Orientation="Horizontal" DataContext="{Binding Source={x:Static gui:GlobalsGUI.Current}}">
                            <Grid Margin="1,-3,0,-2">
                                <Rectangle RadiusX="14" RadiusY="14" Width="11" Height="12" Fill="#FFFFFFFF" HorizontalAlignment="Left" Margin="4,4,0,0" VerticalAlignment="Top" />
                                <wpf:SymbolIcon wpf:SymbolIcon.Symbol="Info" TextBlock.FontSize="19" IconVariant="Filled" TextBlock.Foreground="#256eca" />
                            </Grid>
                            <TextBlock Name="DefaultText" FontSize="14" Margin="15,-3,0,-2" Text="Default configuration will be applied" />
                        </StackPanel>
                        <Button Name="ResetButton" Margin="0,-7,0,-8" Padding="13,0,13,0" Height="29" Style="{DynamicResource TransparentButton}" HorizontalAlignment="Right" Click="ResetButton_OnClick">
                            <TextBlock VerticalAlignment="Center" FontSize="14" Margin="0,0,0,1" Text="Reset" Foreground="{DynamicResource TransparentButtonTextForeground}" />
                        </Button>
                    </Grid>
                </Border>
                <Border Name="RequiredCompletedBox" Visibility="Hidden" VerticalAlignment="Top" Style="{DynamicResource ContentBox}" Height="47" Background="{DynamicResource SuccessBoxBrush}">
                    <Grid>
                        <StackPanel Orientation="Horizontal" DataContext="{Binding Source={x:Static gui:GlobalsGUI.Current}}">
                            <Image Style="{StaticResource QualityImage}" Margin="3,-3,2,-2" Source="/Icons/checkmark_green_solid_32.png" Height="15" />
                            <TextBlock FontSize="14" Margin="15,-3,0,-2" Text="All required configuration completed" TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                        <Button Name="RequiredResetButton" HorizontalAlignment="Right" Margin="0,-7,0,-8" Padding="13,0,13,0" Height="29" Style="{DynamicResource TransparentButton}" Click="ResetButton_OnClick">
                            <TextBlock VerticalAlignment="Center" FontSize="14" Margin="0,0,0,1" Text="Reset" Foreground="{DynamicResource TransparentButtonTextForeground}" />
                        </Button>
                    </Grid>
                </Border>
            </Grid>
            <StackPanel ZIndex="2">
                <Border Name="FeaturesBox" Style="{DynamicResource ContentBox}" Height="62">
                    <Grid>
                        <StackPanel Name="FeaturesStack" HorizontalAlignment="Left" Orientation="Horizontal" Opacity="1">
                            <Image Style="{StaticResource QualityImage}" Margin="0,1,0,0" Source="{DynamicResource UsbDrive32}" Width="32" VerticalAlignment="Center" HorizontalAlignment="Left" />
                            <StackPanel Margin="8,-3,0,-4">
                                <TextBlock Name="CustomFeaturesHeader" FontSize="15" Text="Customize Features" />
                                <TextBlock Name="CustomFeaturesDescriptor" FontSize="13" Foreground="{DynamicResource TextSecondaryBrush}" Text="Modify Playbook functionality" Margin="0,-1,0,0" />
                            </StackPanel>
                        </StackPanel>
                        <Button Name="FeaturesButton" Margin="0,-2,0,-2" Padding="15,0,15,0" Style="{DynamicResource ContentBoxButton}" HorizontalAlignment="Right" Click="FeaturesButton_OnClick">
                            <TextBlock Name="FeaturesButtonText" VerticalAlignment="Center" FontSize="14" Margin="0,0,0,1" Text="Select features" />
                        </Button>
                    </Grid>
                </Border>
            </StackPanel>
        </Grid>
        <TextBlock Grid.Row="2" VerticalAlignment="Bottom" FontSize="14" Foreground="{DynamicResource PageSubtextColor}">Click the <Bold>Next</Bold> button below to continue.</TextBlock>
        <Popup Name="ConfirmPopup" Grid.RowSpan="2" Grid.Row="0" UseLayoutRounding="True" Width="700" Height="490" VerticalOffset="-490" IsOpen="False" StaysOpen="True" PopupAnimation="Fade" AllowsTransparency="True" PlacementTarget="{Binding RelativeSource={RelativeSource AncestorType=Window}}" MouseLeftButtonDown="FocusWindow">
            <Border UseLayoutRounding="True" Padding="132,42,133,44" CornerRadius="{DynamicResource PopupCornerRadius}" Background="#44000000">
                <Border UseLayoutRounding="True" Width="365" Height="323" CornerRadius="9" BorderThickness="1" BorderBrush="{DynamicResource LicensePopupBorder}" Background="{DynamicResource LicensePopupBackground}">
                    <UIElement.Effect>
                        <DropShadowEffect ShadowDepth="0" BlurRadius="40" Opacity="0.27" />
                    </UIElement.Effect>
                    <StackPanel>
                        <UIElement.Clip>
                            <RectangleGeometry Rect="0,0,363,1000" />
                        </UIElement.Clip>
                        <Grid Name="ConfirmMainContainerGrid" HorizontalAlignment="Left" Margin="0,0,0,0" VerticalAlignment="Stretch">
                            <Grid Margin="27,18,26,25" Height="227">
                                <StackPanel VerticalAlignment="Top">
                                    <TextBlock FontSize="16" FontWeight="Bold" Text="Erase Confirmation" />
                                    <TextBlock FontSize="13" HorizontalAlignment="Left" Width="285" Margin="0,21,0,0" Text="Check to agree that all data on the selected device will be permanently erased." TextWrapping="Wrap" />
                                    <TextBlock Margin="0,10,0,0" Visibility="Visible" Text="This action is irreversible" FontSize="13" TextTrimming="CharacterEllipsis" Foreground="{DynamicResource TextSecondaryBrush}" />
                                </StackPanel>
                                <CheckBox Name="ConfirmCheckbox" Style="{DynamicResource Unchecked}" IsChecked="False" VerticalAlignment="Bottom" Checked="ToggleButton_OnChecked" Unchecked="ToggleButton_OnUnchecked">
                                    <TextBlock Margin="0,1,0,0" Text="Confirm permanent erasure" />
                                </CheckBox>
                            </Grid>
                        </Grid>
                        <Border Margin="0,2,0,0" UseLayoutRounding="True" CornerRadius="0,0,7,7" BorderBrush="{DynamicResource LicensePopupSeparatorBrush}" Height="47" Background="{DynamicResource LicensePopupLowerBrush}" BorderThickness="0,1,0,0">
                            <StackPanel UseLayoutRounding="True" Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Right" Margin="0,2,13,0">
                                <Button Name="ConfirmSelectSelectButton" UseLayoutRounding="True" Style="{DynamicResource BlueButton}" Margin="0,0,13,0" Click="ConfirmSelectSelectButton_OnClick">
                                    <TextBlock Text="Next" Foreground="#FFFFFFFF" FontSize="11" Margin="-3,0,-3,0" IsEnabled="False" />
                                </Button>
                                <Button Name="ConfirmSelectCancelButton" UseLayoutRounding="True" Padding="0" Width="78" Style="{DynamicResource SpecialButton}" IsEnabled="True" Click="SelectCancelButton_OnClick">
                                    <TextBlock Text="Cancel" Margin="0,1,0,0" FontSize="11" />
                                </Button>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Border>
            </Border>
        </Popup>
        <Popup Name="OptionsPopup" Grid.RowSpan="2" Grid.Row="0" UseLayoutRounding="True" Width="700" Height="490" VerticalOffset="-490" IsOpen="False" StaysOpen="True" PopupAnimation="Fade" AllowsTransparency="True" PlacementTarget="{Binding RelativeSource={RelativeSource AncestorType=Window}}" MouseLeftButtonDown="FocusWindow">
            <Border UseLayoutRounding="True" Padding="132,42,133,44" CornerRadius="{DynamicResource PopupCornerRadius}" Background="#44000000">
                <Border UseLayoutRounding="True" Width="365" Height="323" CornerRadius="9" BorderThickness="1" BorderBrush="{DynamicResource LicensePopupBorder}" Background="{DynamicResource LicensePopupBackground}">
                    <UIElement.Effect>
                        <DropShadowEffect ShadowDepth="0" BlurRadius="40" Opacity="0.27" />
                    </UIElement.Effect>
                    <pages:IsoOptionsPane x:Name="OptionsPane" />
                </Border>
            </Border>
        </Popup>
    </Grid>
</UserControl>
