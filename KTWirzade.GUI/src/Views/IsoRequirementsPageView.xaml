<UserControl x:Class="KTWirzade.GUI.Views.IsoRequirementsPageView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:KTWirzade.GUI.Views"
             xmlns:controls="clr-namespace:KTWirzade.GUI.Controls"
             xmlns:wpf="clr-namespace:FluentIcons.Wpf;assembly=FluentIcons.Wpf"
             xmlns:gui="clr-namespace:KTWirzade.GUI"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">
    
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="89" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <StackPanel Margin="0,0,0,0" MinHeight="70">
            <TextBlock Style="{DynamicResource Header}" Margin="0,0,0,13" TextTrimming="WordEllipsis" DataContext="{Binding Source={x:Static gui:GlobalsGUI.Current}}" Text="{Binding ISO.Title}" />
            <TextBlock HorizontalAlignment="Left" FontSize="13" Text="Verificando compilacao do Windows e status do sistema" Foreground="{DynamicResource PageSubtextColor}" />
        </StackPanel>
        <Grid Name="ActivationContainer" Row="1" VerticalAlignment="Top" HorizontalAlignment="Left" Margin="2,0,0,18" Height="76">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="70" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Grid Width="57" Height="58" VerticalAlignment="Top" HorizontalAlignment="Left">
                <Image Style="{StaticResource QualityImage}" Source="/Icons/activation_blue_gradient_128.png" Width="47" VerticalAlignment="Top" HorizontalAlignment="Left" />
                <Image Style="{StaticResource QualityImage}" Width="21" HorizontalAlignment="Right" VerticalAlignment="Bottom" Source="{Binding ActivationIcon}" />
            </Grid>
            <StackPanel Grid.Column="1" Margin="2,8,0,0">
                <TextBlock Style="{DynamicResource Header}" FontSize="16" Text="{Binding ActivationStatusText}" />
                <TextBlock Margin="0,1,0,0" Foreground="#FF808080" Style="{DynamicResource InText}" Text="{Binding ActivationResultText}" Visibility="{Binding ActivationResultTextVisibility}" />
                <controls:ProgressBarIndeterminate x:Name="ActivationBar" Width="250" Visibility="Visible" BoardTime="0:0:1.8" Margin="0,3,0,0" VerticalAlignment="Top" BetweenDelay="400" HorizontalAlignment="Left" />
            </StackPanel>
        </Grid>
        <Grid Name="SystemCheckContainer" Row="2" Opacity="0.6" VerticalAlignment="Top" HorizontalAlignment="Left" Margin="2,0,0,0" Height="80">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="70" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Grid Width="57" Height="49" VerticalAlignment="Top" HorizontalAlignment="Left">
                <Image Style="{StaticResource QualityImage}" Source="/Icons/features_blue_gradient_128.png" Width="47" VerticalAlignment="Top" HorizontalAlignment="Left" />
                <Image Style="{StaticResource QualityImage}" Width="21" HorizontalAlignment="Right" VerticalAlignment="Bottom" Source="{Binding SystemCheckIcon}" />
            </Grid>
            <StackPanel Grid.Column="1" Margin="2,0,0,0">
                <TextBlock Style="{DynamicResource Header}" FontSize="16" Margin="0,3,0,0" Text="{Binding SystemCheckStatusText}" />
                <TextBlock Margin="0,1,0,0" Width="195" HorizontalAlignment="Left" TextWrapping="Wrap" Foreground="#FF808080" Style="{DynamicResource InText}" Text="{Binding SystemCheckResultText}" Visibility="{Binding ResultTextVisibility}" />
                <controls:ProgressBarIndeterminate x:Name="SystemBar" Width="250" Visibility="Hidden" BoardTime="0:0:1.8" Margin="0,3,0,0" BetweenDelay="400" VerticalAlignment="Top" HorizontalAlignment="Left" />
            </StackPanel>
        </Grid>
        <StackPanel Name="BoxesContainer" Grid.Row="3" Height="62" VerticalAlignment="Top" Margin="0,0,0,3">
            <Border Name="CheckBatteryBox" Grid.Row="1" Style="{DynamicResource ContentBox}" Height="62" Visibility="Collapsed">
                <Grid>
                    <StackPanel HorizontalAlignment="Left" Orientation="Horizontal">
                        <wpf:SymbolIcon TextBlock.Foreground="{DynamicResource ButtonTextPrimaryBrush}" wpf:SymbolIcon.Symbol="BatteryCharge" TextBlock.FontSize="27" FrameworkElement.Margin="5,2,0,0" RenderOptions.BitmapScalingMode="Fant" FrameworkElement.VerticalAlignment="Center" FrameworkElement.HorizontalAlignment="Left" />
                        <StackPanel Margin="17,-3,0,-3">
                            <TextBlock FontSize="15" Foreground="{DynamicResource TextSoftBrush}" Text="Conectar carregador" Margin="0,-1,0,0" />
                            <TextBlock FontSize="13" Foreground="{DynamicResource TextSecondaryBrush}" Text="Condicao necessaria para este playbook" Margin="0,-1,0,0" />
                        </StackPanel>
                    </StackPanel>
                    <Button Name="CheckBatteryButton" Margin="0,-2,0,-2" Padding="20,0,20,0" Style="{DynamicResource ContentBoxButton}" HorizontalAlignment="Right" Click="CheckBatteryButton_OnClick">
                        <TextBlock VerticalAlignment="Center" FontSize="14" Margin="0,0,0,2" Text="Verificar novamente" />
                    </Button>
                </Grid>
            </Border>
            <Border Name="CheckInternetBox" Grid.Row="1" Style="{DynamicResource ContentBox}" Height="62" Visibility="Collapsed">
                <Grid>
                    <StackPanel HorizontalAlignment="Left" Orientation="Horizontal">
                        <Image Style="{StaticResource QualityImage}" Margin="5,0,0,0" Source="{DynamicResource Web32}" Width="21" VerticalAlignment="Center" HorizontalAlignment="Left" />
                        <StackPanel Margin="20,-3,0,-3">
                            <TextBlock FontSize="15" Foreground="{DynamicResource TextSoftBrush}" Text="Conectar a internet" Margin="0,-1,0,0" />
                            <TextBlock FontSize="13" Foreground="{DynamicResource TextSecondaryBrush}" Text="Necessario para baixar pacotes" Margin="0,-1,0,0" />
                        </StackPanel>
                    </StackPanel>
                    <Button Name="CheckInternetButton" Margin="0,-2,0,-2" Padding="20,0,20,0" Style="{DynamicResource ContentBoxButton}" HorizontalAlignment="Right" Click="CheckInternetButton_OnClick">
                        <TextBlock VerticalAlignment="Center" FontSize="14" Margin="0,0,0,2" Text="Verificar novamente" />
                    </Button>
                </Grid>
            </Border>
            <Border Name="CheckNoInternetBox" Grid.Row="1" Style="{DynamicResource ContentBox}" Height="62" Visibility="Collapsed">
                <Grid>
                    <StackPanel HorizontalAlignment="Left" Orientation="Horizontal">
                        <Image Style="{StaticResource QualityImage}" Margin="5,0,0,0" Source="{DynamicResource Web32}" Width="21" VerticalAlignment="Center" HorizontalAlignment="Left" />
                        <StackPanel Margin="20,-3,0,-3">
                            <TextBlock FontSize="15" Foreground="{DynamicResource TextSoftBrush}" Text="Desconectar a internet" Margin="0,-1,0,0" />
                            <TextBlock FontSize="13" Foreground="{DynamicResource TextSecondaryBrush}" Text="Condicao necessaria para este playbook" Margin="0,-1,0,0" />
                        </StackPanel>
                    </StackPanel>
                    <Button Name="CheckNoInternetButton" Margin="0,-2,0,-2" Padding="20,0,20,0" Style="{DynamicResource ContentBoxButton}" HorizontalAlignment="Right" Click="CheckNoInternetButton_OnClick">
                        <TextBlock VerticalAlignment="Center" FontSize="14" Margin="0,0,0,2" Text="Verificar novamente" />
                    </Button>
                </Grid>
            </Border>
            <Border Name="PrepareBox" Grid.Row="1" Style="{DynamicResource ContentBox}" Height="62" Visibility="Collapsed">
                <Grid>
                    <StackPanel HorizontalAlignment="Left" Orientation="Horizontal" Margin="1,0,0,0">
                        <Image Style="{StaticResource QualityImage}" Margin="6,0,0,0" Source="{DynamicResource Checklist32}" Width="16" VerticalAlignment="Center" HorizontalAlignment="Left" />
                        <StackPanel Margin="23,-3,0,-3">
                            <TextBlock FontSize="15" Foreground="{DynamicResource TextSoftBrush}" Text="Preparar sistema" Margin="0,-1,0,0" />
                            <TextBlock FontSize="13" Foreground="{DynamicResource TextSecondaryBrush}" Text="Condicoes necessarias para este playbook" Margin="0,-1,0,0" />
                        </StackPanel>
                    </StackPanel>
                    <Button Name="PrepareButton" Margin="0,-2,0,-2" Padding="24,0,24,0" Style="{DynamicResource ContentBoxButton}" HorizontalAlignment="Right" Click="PrepareButton_OnClick">
                        <TextBlock VerticalAlignment="Center" FontSize="14" Margin="0,0,0,1" Text="Run action" />
                    </Button>
                </Grid>
            </Border>
            <Border Name="TweaksBox" Grid.Row="1" Style="{DynamicResource ContentBox}" Height="62" Visibility="Collapsed">
                <Grid>
                    <StackPanel HorizontalAlignment="Left" Orientation="Horizontal">
                        <wpf:SymbolIcon TextBlock.Foreground="{DynamicResource ButtonTextPrimaryBrush}" wpf:SymbolIcon.Symbol="Toolbox" TextBlock.FontSize="27" FrameworkElement.Margin="5,2,0,0" RenderOptions.BitmapScalingMode="Fant" FrameworkElement.VerticalAlignment="Center" FrameworkElement.HorizontalAlignment="Left" />
                        <StackPanel Margin="17,-3,0,-3">
                            <TextBlock FontSize="15" Foreground="{DynamicResource TextSoftBrush}" Text="Desativar tweaks" Margin="0,-1,0,0" />
                            <TextBlock FontSize="13" Foreground="{DynamicResource TextSecondaryBrush}" Text="Condicao necessaria para este playbook" Margin="0,-1,0,0" />
                        </StackPanel>
                    </StackPanel>
                    <Button Name="TweaksButton" Margin="0,-2,0,-2" Padding="24,0,24,0" Style="{DynamicResource ContentBoxButton}" HorizontalAlignment="Right" Click="TweaksButton_OnClick">
                        <TextBlock VerticalAlignment="Center" FontSize="14" Margin="0,0,0,1" Text="Run action" />
                    </Button>
                </Grid>
            </Border>
            <Border Name="PendingUpdatesBox" Grid.Row="1" Style="{DynamicResource ContentBox}" Height="62" Visibility="Collapsed">
                <Grid>
                    <StackPanel HorizontalAlignment="Left" Orientation="Horizontal">
                        <wpf:SymbolIcon TextBlock.Foreground="{DynamicResource ButtonTextPrimaryBrush}" wpf:SymbolIcon.Symbol="ArrowSync" TextBlock.FontSize="24" FrameworkElement.Margin="5,2,0,0" RenderOptions.BitmapScalingMode="Fant" FrameworkElement.VerticalAlignment="Center" FrameworkElement.HorizontalAlignment="Left" />
                        <StackPanel Margin="17,-3,0,-3">
                            <TextBlock FontSize="15" Foreground="{DynamicResource TextSoftBrush}" Text="Instalar atualizacoes" Margin="0,-1,0,0" />
                            <TextBlock FontSize="13" Foreground="{DynamicResource TextSecondaryBrush}" Text="Condicao necessaria para este playbook" Margin="0,-1,0,0" />
                        </StackPanel>
                    </StackPanel>
                    <Button Name="PendingUpdatesButton" Margin="0,-2,0,-2" Padding="24,0,24,0" Style="{DynamicResource ContentBoxButton}" HorizontalAlignment="Right" Click="PendingUpdatesButton_OnClick">
                        <TextBlock Name="PendingUpdatesActionText" VerticalAlignment="Center" FontSize="14" Margin="0,0,0,1" Text="Run action" />
                    </Button>
                </Grid>
            </Border>
            <Border Name="BuildMismatchBox" Grid.Row="1" Style="{DynamicResource ContentBox}" Height="62" Visibility="Collapsed">
                <Grid>
                    <StackPanel HorizontalAlignment="Left" Orientation="Horizontal">
                        <wpf:SymbolIcon TextBlock.Foreground="{DynamicResource ButtonTextPrimaryBrush}" wpf:SymbolIcon.Symbol="Desktop" TextBlock.FontSize="24" FrameworkElement.Margin="5,2,0,0" RenderOptions.BitmapScalingMode="Fant" FrameworkElement.VerticalAlignment="Center" FrameworkElement.HorizontalAlignment="Left" />
                        <StackPanel Margin="17,-3,0,-3">
                            <TextBlock FontSize="15" Foreground="{DynamicResource TextSoftBrush}" Text="Versão da imagem não suportada" Margin="0,-1,0,0" />
                            <TextBlock FontSize="13" Foreground="{DynamicResource TextSecondaryBrush}" Text="Este playbook foi feito para outra build do Windows" Margin="0,-1,0,0" />
                        </StackPanel>
                    </StackPanel>
                    <Button Name="BypassBuildButton" Margin="0,-2,0,-2" Padding="24,0,24,0" Style="{DynamicResource ContentBoxButton}" HorizontalAlignment="Right" Click="BypassBuildButton_OnClick">
                        <TextBlock VerticalAlignment="Center" FontSize="14" Margin="0,0,0,1" Text="Aplicar mesmo assim" />
                    </Button>
                </Grid>
            </Border>
            <Border Name="FreshInstallBox" Grid.Row="1" Style="{DynamicResource ContentBox}" Height="62" Visibility="Collapsed">
                <Grid>
                    <StackPanel HorizontalAlignment="Left" Orientation="Horizontal">
                        <wpf:SymbolIcon TextBlock.Foreground="{DynamicResource ButtonTextPrimaryBrush}" wpf:SymbolIcon.Symbol="Rewind" TextBlock.FontSize="24" FrameworkElement.Margin="5,2,0,0" RenderOptions.BitmapScalingMode="Fant" FrameworkElement.VerticalAlignment="Center" FrameworkElement.HorizontalAlignment="Left" />
                        <StackPanel Margin="17,-3,0,-3">
                            <TextBlock FontSize="15" Foreground="{DynamicResource TextSoftBrush}" Text="Reinstalar o Windows" Margin="0,-1,0,0" />
                            <TextBlock FontSize="13" Foreground="{DynamicResource TextSecondaryBrush}" Text="Requisito para este playbook" Margin="0,-1,0,0" />
                        </StackPanel>
                    </StackPanel>
                    <StackPanel HorizontalAlignment="Right" Orientation="Horizontal">
                        <TextBlock VerticalAlignment="Bottom" FontSize="11" Margin="0,0,10,0" Grid.Row="2">
              <Hyperlink Click="BypassButton_OnClick" MouseEnter="Hyperlink_OnMouseEnter" MouseLeave="Hyperlink_OnMouseLeave">Ignorar</Hyperlink>
                        </TextBlock>
                        <Button Name="ViewInstallGuideButton" Margin="0,-2,0,-2" Padding="24,0,24,0" Style="{DynamicResource ContentBoxButton}" Click="ViewInstallGuideButton_OnClick">
                            <TextBlock Name="FreshInstallActionText" VerticalAlignment="Center" FontSize="14" Margin="0,0,0,1" Text="Ver guia" />
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>
        </StackPanel>
        <CheckBox Name="activationAccept" Content="Eu entendo que meu sistema ja esta otimizado." VerticalAlignment="Bottom" Grid.Row="2" IsEnabled="False" Visibility="Collapsed" Checked="activationAccept_Checked" Unchecked="activationAccept_Checked" />
    </Grid>
</UserControl>
