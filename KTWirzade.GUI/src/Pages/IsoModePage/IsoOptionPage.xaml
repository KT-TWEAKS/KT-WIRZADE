<UserControl x:Class="KTWirzade.GUI.Pages.IsoModePage.IsoOptionPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:KTWirzade.GUI.Pages.IsoModePage"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">
    
    <StackPanel Margin="27,18,26,0">
        <TextBlock Name="Title" FontSize="16" FontWeight="Bold" Text="Custom Features" />
        <Grid Name="ModuleGrid" Height="93" Opacity="0" Margin="0,-93,0,0">
            <StackPanel Name="BrowserModule" Visibility="Collapsed">
                <UIElement.RenderTransform>
                    <TransformGroup>
                        <ScaleTransform CenterX="100" x:Name="browsertransform" />
                    </TransformGroup>
                </UIElement.RenderTransform>
                <StackPanel Orientation="Horizontal">
                    <TextBlock Name="BrowserText" FontSize="13" Width="276" Height="35" Margin="0,21,0,0" Text="It looks like you are already using Google Chrome. Would you like to keep it as default?" TextWrapping="Wrap" TextTrimming="CharacterEllipsis" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,15,0,0">
                    <Button Name="BrowserKeepButton" UseLayoutRounding="True" Style="{DynamicResource SpecialButton}" Margin="0,0,6,0" Click="BrowserKeepButton_OnClick">
                        <TextBlock Text="Keep mine" Margin="0,1,0,0" FontSize="11" />
                    </Button>
                    <Button Name="BrowserInstallButton" UseLayoutRounding="True" Style="{DynamicResource TransparentButton}" Padding="7,0,7,0" Height="22" Click="BrowserInstallButton_OnClick">
                        <TextBlock Text="Install new browser" Tag="3" VerticalAlignment="Center" Margin="0,0,0,1" Foreground="{DynamicResource TransparentButtonTextForeground}" FontSize="11" />
                    </Button>
                </StackPanel>
            </StackPanel>
        </Grid>
        <StackPanel Name="ContentGrid">
            <TextBlock Name="DescriptionText" FontSize="13" HorizontalAlignment="Left" Width="276" Height="35" Margin="0,21,0,0" TextWrapping="Wrap" TextTrimming="CharacterEllipsis" Text="{Binding Description}" />
            <Grid>
                <Grid Name="LineBlocksContainer">
                    <TextBlock Name="TopLineBlock" Margin="0,10,0,0" Visibility="Hidden" Text="We strongly recommend all of these options" FontSize="13" TextTrimming="CharacterEllipsis" Foreground="{DynamicResource TextSecondaryBrush}" />
                    <TextBlock Name="BottomLineBlock" VerticalAlignment="Top" HorizontalAlignment="Left" Margin="0,132,0,0" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="13" TextTrimming="CharacterEllipsis" Visibility="Hidden" Text="Automatically login this user on startup" />
                </Grid>
                <StackPanel Name="OptionsContainer" VerticalAlignment="Top" Margin="{Binding OptionsMargin}" />
            </Grid>
        </StackPanel>
    </StackPanel>
</UserControl>
