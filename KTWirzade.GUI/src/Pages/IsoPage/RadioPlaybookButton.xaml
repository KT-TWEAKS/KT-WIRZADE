<RadioButton x:Class="KTWirzade.GUI.Pages.IsoPage.RadioPlaybookButton"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:KTWirzade.GUI.Pages.IsoPage"
             mc:Ignorable="d" 
             HorizontalAlignment="Left" Width="78" Height="76" Opacity="0.8" 
             xmlns:isopage="clr-namespace:KTWirzade.GUI.Pages.IsoPage" 
             DataContext="{Binding RelativeSource={RelativeSource Self}}">

    <FrameworkElement.Style>
        <Style TargetType="{x:Type RadioButton}">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type RadioButton}">
                        <ContentPresenter />
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </FrameworkElement.Style>
    <Border Name="OverlayBorder" BorderThickness="2" CornerRadius="4">
        <Border.BorderBrush>
            <SolidColorBrush Color="{DynamicResource ProgressBarColor}" />
        </Border.BorderBrush>
        <Border Name="OverlayInnerBorder" BorderBrush="{DynamicResource LicensePopupBackground}" UseLayoutRounding="True" BorderThickness="1" CornerRadius="3">
            <Border Name="InnerBorder" CornerRadius="3">
                <Border.Background>
                    <SolidColorBrush x:Name="ColorBrush" Color="{DynamicResource ProgressBarColor}" Opacity="0.10" />
                </Border.Background>
                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                    <Image Name="Image" Style="{StaticResource QualityImage}" Height="35" Margin="0,0,0,0" />
                    <TextBlock Name="Text" Margin="0,5,0,0" TextTrimming="CharacterEllipsis" HorizontalAlignment="Center" Width="72" TextAlignment="Center" />
                </StackPanel>
            </Border>
        </Border>
    </Border>
</RadioButton>