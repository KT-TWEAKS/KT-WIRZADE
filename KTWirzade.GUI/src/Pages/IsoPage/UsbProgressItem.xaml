<CheckBox x:Class="KTWirzade.GUI.Pages.IsoPage.UsbProgressItem"
          xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
          xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
          xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
          xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
          xmlns:local="clr-namespace:KTWirzade.GUI.Pages.IsoPage"
          mc:Ignorable="d" 
          HorizontalAlignment="Left" Width="289" Height="32" Opacity="0.8" 
          xmlns:isopage="clr-namespace:KTWirzade.GUI.Pages.IsoPage" 
          DataContext="{Binding RelativeSource={RelativeSource Self}}">

    <FrameworkElement.Style>
        <Style TargetType="{x:Type CheckBox}">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type CheckBox}">
                        <Border Name="OuterBorder" BorderThickness="2" Background="{DynamicResource UsbItemBackgroundBrush}" CornerRadius="6">
                            <Border.BorderBrush>
                                <SolidColorBrush Color="{DynamicResource ProgressBarColor}" Opacity="0" />
                            </Border.BorderBrush>
                            <Border Name="InnerBorder" BorderBrush="{DynamicResource LicensePopupBackground}" UseLayoutRounding="True" BorderThickness="0" Padding="1" CornerRadius="5">
                                <Border.Background>
                                    <SolidColorBrush x:Name="ColorBrush" Color="{DynamicResource ProgressBarColor}" Opacity="0" />
                                </Border.Background>
                                <Grid>
                                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Left" Orientation="Horizontal">
                                        <Image Name="Image" Style="{StaticResource QualityImage}" Height="17" Margin="7,0,0,0" Source="/Icons/usb_ame_32.png" />
                                        <TextBlock Name="Text" Margin="12,0,0,0" TextTrimming="CharacterEllipsis" HorizontalAlignment="Left" Width="204" Text="{Binding UsbName}" />
                                    </StackPanel>
                                    <TextBlock Name="SizeText" FontWeight="Bold" Margin="0,0,7,0" HorizontalAlignment="Right" VerticalAlignment="Center" Text="{Binding UsbSize}" />
                                </Grid>
                            </Border>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="ToggleButton.IsChecked" Value="True">
                                <Trigger.Setters>
                                    <Setter TargetName="InnerBorder" Property="Border.Padding" Value="0" />
                                    <Setter TargetName="InnerBorder" Property="Border.BorderThickness" Value="1" />
                                </Trigger.Setters>
                            </Trigger>
                            <Trigger Property="ToggleButton.IsChecked" Value="False">
                                <Trigger.Setters>
                                    <Setter TargetName="InnerBorder" Property="Border.Padding" Value="1" />
                                    <Setter TargetName="InnerBorder" Property="Border.BorderThickness" Value="0" />
                                </Trigger.Setters>
                            </Trigger>
                            <Trigger Property="ToggleButton.IsChecked" Value="True">
                                <TriggerBase.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Duration="0:0:0.1" Storyboard.TargetProperty="BorderBrush.Opacity" Storyboard.TargetName="OuterBorder" To="1" />
                                        </Storyboard>
                                    </BeginStoryboard>
                                </TriggerBase.EnterActions>
                                <TriggerBase.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Duration="0:0:0.1" Storyboard.TargetProperty="BorderBrush.Opacity" Storyboard.TargetName="OuterBorder" To="0" />
                                        </Storyboard>
                                    </BeginStoryboard>
                                </TriggerBase.ExitActions>
                            </Trigger>
                            <MultiTrigger>
                                <MultiTrigger.Conditions>
                                    <Condition Property="ToggleButton.IsChecked" Value="False" />
                                    <Condition Property="UIElement.IsMouseOver" Value="False" />
                                </MultiTrigger.Conditions>
                                <TriggerBase.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Duration="0:0:0.1" Storyboard.TargetProperty="Background.Opacity" Storyboard.TargetName="InnerBorder" To="0.00" />
                                        </Storyboard>
                                    </BeginStoryboard>
                                </TriggerBase.EnterActions>
                                <TriggerBase.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Duration="0:0:0.1" Storyboard.TargetProperty="Background.Opacity" Storyboard.TargetName="InnerBorder" To="0.08125" />
                                        </Storyboard>
                                    </BeginStoryboard>
                                </TriggerBase.ExitActions>
                            </MultiTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </FrameworkElement.Style>
</CheckBox>