<UserControl x:Class="KTWirzade.GUI.Pages.ModePage.FeaturesPane"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:KTWirzade.GUI.Pages.ModePage"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">
    <Grid>
        <StackPanel Width="363" Height="321">
            <UIElement.Clip>
                <RectangleGeometry Rect="0,0,363,1000" />
            </UIElement.Clip>
            <Grid Name="MainContainerGrid" HorizontalAlignment="Left" Height="272" Margin="0,0,0,0" />
            <Border Margin="0,0,0,0" UseLayoutRounding="True" CornerRadius="0,0,7,7" BorderBrush="{DynamicResource LicensePopupSeparatorBrush}" Height="47" Background="{DynamicResource LicensePopupLowerBrush}" BorderThickness="0,1,0,0">
                <StackPanel UseLayoutRounding="True" Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Right" Margin="0,2,13,0">
                    <Button Name="NextButton" UseLayoutRounding="True" Style="{DynamicResource BlueButton}" Margin="0,0,13,0" Click="NextButton_OnClick">
                        <TextBlock Name="NextText" Text="Next" Foreground="#FFFFFFFF" FontSize="11" Margin="0" />
                    </Button>
                    <Button UseLayoutRounding="True" Padding="0" Width="78" Style="{DynamicResource SpecialButton}" Click="Cancel_OnClick">
                        <TextBlock Text="Cancel" Margin="0,1,0,0" FontSize="11" />
                    </Button>
                </StackPanel>
            </Border>
        </StackPanel>
    </Grid>
</UserControl>