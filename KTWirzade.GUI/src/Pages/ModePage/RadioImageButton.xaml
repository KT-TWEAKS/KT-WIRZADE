<RadioButton x:Class="KTWirzade.GUI.Pages.ModePage.RadioImageButton"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:KTWirzade.GUI.Pages.ModePage"
             mc:Ignorable="d" HorizontalAlignment="Left" Width="66" Opacity="0.8">
    <FrameworkElement.Style>
        <Style TargetType="{x:Type RadioButton}">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type RadioButton}">
                        <ContentPresenter />
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </FrameworkElement.Style>
    <Grid HorizontalAlignment="Left" Width="66">
        <Border Margin="2" Height="44" CornerRadius="5" VerticalAlignment="Top">
            <Border.Background>
                <LinearGradientBrush StartPoint="1,0">
                    <GradientStop x:Name="TopGradient" Color="#FF3647" Offset="0" />
                    <GradientStop x:Name="BottomGradient" Color="#FFC742" Offset="1" />
                </LinearGradientBrush>
            </Border.Background>
            <Image Name="Image" Height="34" RenderOptions.BitmapScalingMode="Fant" UseLayoutRounding="True" />
        </Border>
        <Grid Name="OverlayContainer" VerticalAlignment="Top" Height="48" Width="66" Opacity="0">
            <Border BorderBrush="{DynamicResource LicensePopupBackground}" BorderThickness="1" Margin="2" CornerRadius="1" />
            <Border Name="BlueBorder" BorderThickness="2" CornerRadius="4">
                <Border.BorderBrush>
                    <SolidColorBrush Color="{DynamicResource ProgressBarColor}" />
                </Border.BorderBrush>
                <Border BorderBrush="{DynamicResource LicensePopupBackground}" BorderThickness="1" CornerRadius="3" />
            </Border>
        </Grid>
        <TextBlock Name="Text" Margin="0,51,0,0" MaxWidth="60" TextTrimming="CharacterEllipsis" Text="Firefox" FontSize="11" Opacity="0.85" HorizontalAlignment="Center" />
    </Grid>
</RadioButton>
