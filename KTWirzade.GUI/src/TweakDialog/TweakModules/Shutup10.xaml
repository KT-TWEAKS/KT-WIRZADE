<Grid x:Class="KTWirzade.GUI.TweakDialog.TweakModules.Shutup10"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:KTWirzade.GUI.TweakDialog.TweakModules"
      xmlns:controls="clr-namespace:KTWirzade.GUI.Controls"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">
    <Grid.ColumnDefinitions>
        <ColumnDefinition Width="395" />
        <ColumnDefinition Width="*" />
    </Grid.ColumnDefinitions>
    <Grid Name="LeftGrid" VerticalAlignment="Top" Margin="0,80,0,0" UseLayoutRounding="True">
        <Grid Width="313" HorizontalAlignment="Center" VerticalAlignment="Center">
            <UIElement.Effect>
                <DropShadowEffect BlurRadius="18" Opacity="0.45" ShadowDepth="0" />
            </UIElement.Effect>
            <Image Name="Shutup10Main" Source="{DynamicResource Shutup10MainBitmap}" Style="{DynamicResource QualityImage}" />
            <Image Name="Shutup10Toggled" Opacity="0" Source="{DynamicResource Shutup10ToggledBitmap}" Style="{DynamicResource QualityImage}" />
            <StackPanel Margin="25,18,0,0" HorizontalAlignment="Left" VerticalAlignment="Top">
                <Border Name="ActionsHoverEffect" Opacity="0" Height="14" Width="28" VerticalAlignment="Top" HorizontalAlignment="Left" CornerRadius="4">
                    <Border.Background>
                        <SolidColorBrush Color="{DynamicResource ButtonTextPrimaryColor}" Opacity="0.05" />
                    </Border.Background>
                </Border>
                <Grid Name="Shutup10DropdownGrid" Opacity="0">
                    <Image Name="Shutup10Dropdown" Opacity="1" Source="{DynamicResource Shutup10DropdownBitmap}" Style="{DynamicResource QualityImage}" Height="78" Margin="0,0,0,0">
                        <UIElement.Effect>
                            <DropShadowEffect BlurRadius="3" Opacity="0.6" ShadowDepth="1" Direction="290" />
                        </UIElement.Effect>
                    </Image>
                    <Border Name="UndoHoverEffect" Opacity="0" Height="14" Width="163" VerticalAlignment="Bottom" Margin="1,0,0,15" CornerRadius="4">
                        <Border.Background>
                            <SolidColorBrush Color="{DynamicResource ButtonTextPrimaryColor}" Opacity="0.05" />
                        </Border.Background>
                    </Border>
                </Grid>
            </StackPanel>
            <Grid Name="Shutup10ModelGrid" Opacity="0">
                <Image Name="Shutup10Model" Height="110" Source="{DynamicResource Shutup10ModelBitmap}">
                    <UIElement.Effect>
                        <DropShadowEffect BlurRadius="4" Opacity="0.6" ShadowDepth="1" Direction="290" />
                    </UIElement.Effect>
                </Image>
                <Image Name="Shutup10YesNo" Height="13" Source="{DynamicResource Shutup10YesNoBitmap}" Opacity="0" VerticalAlignment="Top" HorizontalAlignment="Right" Margin="0,207,35,0" />
                <Image Name="Shutup10YesNoHover" Height="13" Source="{DynamicResource Shutup10YesNoHoverBitmap}" Opacity="0" VerticalAlignment="Top" HorizontalAlignment="Right" Margin="0,207,35,0" />
            </Grid>
            <Image Name="MouseCursor" Style="{DynamicResource QualityImage}" Width="5" Source="{StaticResource MouseCursorBitmap}" VerticalAlignment="Top" HorizontalAlignment="Left" Visibility="Visible" Margin="110,72,0,0" RenderTransformOrigin="0.5,0.5">
                <UIElement.RenderTransform>
                    <TranslateTransform x:Name="CursorTransform" />
                </UIElement.RenderTransform>
            </Image>
        </Grid>
    </Grid>
    <Grid Name="PageColumn" Column="1" Height="485" VerticalAlignment="Top" Margin="0,0,26,26">
        <Border Name="PageBackgroundBorder" Background="{DynamicResource PageBackground}" Opacity="1" CornerRadius="9,9,9,9" Margin="0,0,0,0" />
        <Border Name="PageGrid" BorderBrush="{DynamicResource PageBorderBrush}" BorderThickness="1,1,1,1" Background="#00FFFFFF" CornerRadius="8,8,8,8" Padding="29,31,29,0" />
        <StackPanel Margin="30,32,30,0">
            <TextBlock FontSize="16" FontWeight="Bold" Text="Reset and Remove Shutup10++" />
            <TextBlock Name="ToStartText" FontSize="13" TextWrapping="Wrap" Margin="0,14,0,32" Text="To start using this Playbook. These tweaks cause conflicts with various modifications, along with some duplicated functionality." />
            <Grid Name="ModuleGrid" Margin="0,-106,0,0" Opacity="0">
                <TextBlock />
                <StackPanel Name="NotFoundGrid" Visibility="Collapsed" RenderTransformOrigin="0.5,0.5" Height="106">
                    <UIElement.RenderTransform>
                        <TransformGroup>
                            <ScaleTransform CenterX="100" x:Name="notfoundtransform" />
                        </TransformGroup>
                    </UIElement.RenderTransform>
                    <controls:TextListItem Prefix="1.     " PrefixVisibility="Hidden" FontSize="13" MaxWidth="380" HorizontalAlignment="Left">
                        <controls:TextListItem.Inlines>
                            <Run FontSize="13" Text="The Shutup10++ executable cannot be located. Please&#xD;&#xA;locate the executable, or simply reset all settings." />
                        </controls:TextListItem.Inlines>
                    </controls:TextListItem>
                    <TextBlock />
                    <StackPanel Margin="5,-1,0,0" Orientation="Horizontal">
                        <TextBlock Text="       " />
                        <Button Name="ModuleLocateButton" Style="{DynamicResource ContentBoxButton}" Click="ModuleLocateButton_OnClick">
                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Orientation="Horizontal">
                                <TextBlock VerticalAlignment="Center" HorizontalAlignment="Center" FontSize="14" Margin="0,0,0,1" Text="Locate app..." />
                            </StackPanel>
                        </Button>
                        <Button Name="ModuleResetButton" Height="32" Margin="8,0,0,-6" Padding="11,4,11,4" Style="{DynamicResource TransparentButton}" Click="ModuleResetButton_OnClick">
                            <TextBlock Name="ImGoodText" VerticalAlignment="Center" FontSize="14" Margin="0,0,0,1" Text="Reset Settings" Foreground="{DynamicResource TransparentButtonTextForeground}" />
                        </Button>
                        <Grid Name="ModuleLoadContainer" Margin="8,0,0,0" Visibility="Collapsed" Width="16" Height="16" />
                    </StackPanel>
                    <TextBlock />
                </StackPanel>
            </Grid>
            <Grid Name="StepsProgressContainer">
                <Grid.RowDefinitions>
                    <RowDefinition Height="182" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <StackPanel Name="Steps">
                    <controls:TextListItem Margin="0,9,0,0" Prefix="1.     " FontSize="13" TextWrapping="Wrap" MaxWidth="380" HorizontalAlignment="Left">
                        <controls:TextListItem.Inlines>
                            <Run FontSize="13" Text="Click the button below to " />
                            <Run FontSize="13" FontWeight="Bold" Text="Run Shutup10++" />
                            <Run FontSize="13" Text=", or revert all changes and remove the program." />
                        </controls:TextListItem.Inlines>
                    </controls:TextListItem>
                    <TextBlock />
                    <StackPanel Margin="5,-1,0,0" Orientation="Horizontal">
                        <TextBlock Text="       " />
                        <Button Name="RunAppButton" Style="{DynamicResource ContentBoxButton}" Click="RunAppButton_OnClick">
                            <TextBlock VerticalAlignment="Center" FontSize="14" Margin="0,0,0,1" Text="Run Shutup10++" />
                        </Button>
                        <Button Name="ResetButton" Height="32" Margin="8,0,0,-6" Padding="11,4,11,4" Style="{DynamicResource TransparentButton}" Click="ResetButton_OnClick">
                            <TextBlock VerticalAlignment="Center" FontSize="14" Margin="0,0,0,1" Text="Reset and Delete" Foreground="{DynamicResource TransparentButtonTextForeground}" />
                        </Button>
                        <Grid Name="LoadContainer" Margin="8,0,0,0" Visibility="Collapsed" Width="16" Height="16" />
                    </StackPanel>
                    <TextBlock />
                    <controls:TextListItem x:Name="Stexp2" Margin="0,10,0,0" FontSize="13" Prefix="2.     " TextWrapping="Wrap" Width="340" HorizontalAlignment="Left">
                        <controls:TextListItem.Inlines>
                            <Run FontSize="13" Text="Navigate to " />
                            <Run FontSize="13" FontWeight="Bold" Text="Actions " />
                            <Run FontWeight="Bold" FontSize="8" Text="▶" BaselineAlignment="Center" />
                            <Run FontSize="13" FontWeight="Bold" Text=" Undo all changes" />
                            <Run FontSize="13" Text=" to factory reset Shutup10++." />
                        </controls:TextListItem.Inlines>
                    </controls:TextListItem>
                </StackPanel>
                <Grid Row="1" Margin="1,0,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="73" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid Width="57" Height="50" HorizontalAlignment="Left">
                        <Image Name="SoftwareIcon" Style="{DynamicResource QualityImage}" Source="/Icons/custom_software_blue_gradient_128.png" Width="47" HorizontalAlignment="Left" VerticalAlignment="Top" />
                        <Image Name="CheckmarkIcon" Style="{DynamicResource QualityImage}" Source="/Icons/checkmark_green_gradient_32.png" Visibility="Hidden" Height="21" HorizontalAlignment="Right" VerticalAlignment="Bottom" />
                    </Grid>
                    <StackPanel Grid.Column="1" HorizontalAlignment="Left">
                        <TextBlock Name="StatusText" FontWeight="Bold" Margin="0,4,0,3" FontSize="15" Text="Monitoring system state..." />
                        <controls:ProgressBarIndeterminate x:Name="ProgressBar" Width="292" HorizontalAlignment="Left" />
                        <TextBlock Name="FinishText" Visibility="Collapsed" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,-1,0,0" Text="Restart at the soonest possible time" />
                    </StackPanel>
                </Grid>
            </Grid>
        </StackPanel>
    </Grid>
</Grid>
