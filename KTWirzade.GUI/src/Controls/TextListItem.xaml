<UserControl x:Class="KTWirzade.GUI.Controls.TextListItem"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:KTWirzade.GUI.Controls"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <TextBlock Name="PrefixBlock" Text="{Binding Prefix}" FontWeight="{Binding FontWeight}" Visibility="{Binding PrefixVisibility}" />
        <TextBlock Name="MainBlock" Grid.Column="1" TextWrapping="{Binding TextWrapping}" Text="{Binding Text}" TextTrimming="{Binding TextTrimming}" FontSize="{Binding FontSize}" LineHeight="{Binding LineHeight}" />
    </Grid>
</UserControl>
