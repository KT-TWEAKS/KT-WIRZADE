<UserControl x:Class="KTWirzade.GUI.Controls.PatreonModel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:KTWirzade.GUI.Controls"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="250">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="40" />
            <RowDefinition Height="45" />
            <RowDefinition Height="*" />
            <RowDefinition Height="40" />
        </Grid.RowDefinitions>
        <DockPanel Name="PopupTitleBar" Dock="Top" VerticalAlignment="Top">
            <Image Style="{StaticResource QualityImage}" Margin="8, 6,0,0" VerticalAlignment="Top" Source="/Icons/ICO.ico" Width="18" Height="18" />
            <Button Name="PopupCloseButton" Style="{DynamicResource CloseButton}" Padding="0,0,0,50" Visibility="Visible" DockPanel.Dock="Right" VerticalAlignment="Top" IsEnabled="{Binding CloseButtonActive}" Click="PopupCloseButton_OnClick">
                <UIElement.Clip>
                    <RectangleGeometry Rect="-8,0,48,37" RadiusX="7" RadiusY="7" />
                </UIElement.Clip>
            </Button>
            <TextBlock Name="PopupTitleSpace" VerticalAlignment="Top" Margin="7,0,0,0" Padding="0,9.5,0,5" FontSize="12" LineStackingStrategy="BlockLineHeight" LineHeight="12" Text="Patrons" Height="25" />
        </DockPanel>
        <TextBox Name="SearchBox" Grid.Row="1" Width="110" FontSize="14" Margin="1,0,0,0" VerticalAlignment="Top" MaxLines="1" MaxLength="16" Foreground="{DynamicResource TextPrimaryBrush}" Template="{DynamicResource SearchBox}" PreviewMouseLeftButtonDown="FocusWindow" TextChanged="SearchBox_OnTextChanged" />
        <TextBlock Name="NoResults" FontSize="12" Grid.Row="2" HorizontalAlignment="Center" TextAlignment="Center" RenderTransformOrigin="0.5,0.5" VerticalAlignment="Top" Text="No results" Opacity="0">
      <UIElement.RenderTransform>
        <ScaleTransform x:Name="NoResultsScale" CenterX="0" CenterY="0" ScaleX="{Binding ScaleY, RelativeSource={RelativeSource Self}}" />
      </UIElement.RenderTransform>
        </TextBlock>
        <ItemsControl Name="Items" Grid.Row="2" Width="104" HorizontalAlignment="Center" VerticalAlignment="Top">
            <Control.Template>
                <ControlTemplate TargetType="{x:Type ItemsControl}">
                    <StackPanel Height="198" VerticalAlignment="Top">
                        <ItemsPresenter VerticalAlignment="Top" Height="10000" RenderTransformOrigin="0.5,0.5">
                            <UIElement.RenderTransform>
                                <TranslateTransform x:Name="Presenter" Y="0" />
                            </UIElement.RenderTransform>
                        </ItemsPresenter>
                    </StackPanel>
                </ControlTemplate>
            </Control.Template>
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <TextBlock TextAlignment="Center" VerticalAlignment="Top" Opacity="1" HorizontalAlignment="Center" Width="104" TextTrimming="CharacterEllipsis" Margin="0,0,0,3" RenderTransformOrigin="0.5,0.5" Text="{Binding Key}" FontWeight="{Binding Value}">
            <UIElement.RenderTransform>
              <TransformGroup>
                <ScaleTransform x:Name="Transform" CenterX="0" CenterY="0" ScaleX="{Binding ScaleY, RelativeSource={RelativeSource Self}}" />
                <TranslateTransform x:Name="Move" />
              </TransformGroup>
            </UIElement.RenderTransform>
                    </TextBlock>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
        <Button Name="PatreonButton" Grid.Row="3" Width="92" Padding="1,0,0,0" Margin="0,-32,0,0" Style="{DynamicResource ContentBoxButton}" Click="PatreonButton_OnClick">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Orientation="Horizontal">
                <Image Height="12" Style="{StaticResource QualityImage}" Source="{DynamicResource ExternalLink32}" Margin="0,0,9,0" />
                <TextBlock VerticalAlignment="Center" Text="Website" FontSize="14" Margin="0,0,0,1" />
            </StackPanel>
        </Button>
    </Grid>
</UserControl>