<UserControl x:Class="KTWirzade.GUI.Controls.LicensePropertyControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:KTWirzade.GUI.Controls"
             mc:Ignorable="d" x:Name="parent"
             d:DesignHeight="450" d:DesignWidth="800">
    <Grid
		DataContext="{Binding ElementName=parent}">
        <Grid.RowDefinitions>
            <RowDefinition
				Height="Auto" />
            <RowDefinition
				Height="*" />
        </Grid.RowDefinitions>
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition
					Width="Auto" />
                <ColumnDefinition
					Width="*" />
            </Grid.ColumnDefinitions>
            <Image
				Source="/Icons/checkmark_green_solid_128.png"
				Height="14"
				Margin="0,2,4,0" />
            <TextBlock
				Grid.Column="1"
				FontSize="14"
				Style="{DynamicResource InText}"
				Text="{Binding Path=Title}" />
        </Grid>
        <TextBlock
			Margin="18,3,0,0"
			Grid.Row="1"
			TextWrapping="Wrap"
			Style="{DynamicResource InText}"
			FontSize="11"
			Text="{Binding Path=Description}" />
    </Grid>
</UserControl>
