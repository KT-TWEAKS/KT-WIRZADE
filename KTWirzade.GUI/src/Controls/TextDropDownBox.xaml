<UserControl x:Class="KTWirzade.GUI.Controls.TextDropDownBox"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:KTWirzade.GUI.Controls"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">
    <StackPanel>
        <Button Name="Button" Template="{DynamicResource TextDropDownTemplate}" Click="DropButton_OnClick" />
        <Border Name="ScrollBorder" UseLayoutRounding="True" CornerRadius="0,0,5,5" BorderBrush="{DynamicResource TextDropDownBorderBrush}" Height="0" BorderThickness="1,0,1,1" Background="{DynamicResource TextDropDownBackground}" VerticalAlignment="Top" Padding="15,7,15,7">
            <Grid>
                <Rectangle Name="Thumb" HorizontalAlignment="Right" Width="2" RadiusX="3" RadiusY="1" Fill="#83878a" VerticalAlignment="Top" Margin="0,5,-12,0" Height="{Binding ThumbHeight}" />
                <ScrollViewer Name="Scroller" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Hidden">
                    <ContentPresenter Content="{Binding Contents}" />
                </ScrollViewer>
            </Grid>
        </Border>
    </StackPanel>
</UserControl>
