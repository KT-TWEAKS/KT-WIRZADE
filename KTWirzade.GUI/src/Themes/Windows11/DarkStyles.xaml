    <ControlTemplate x:Key="PasswordBox" TargetType="{x:Type PasswordBox}">
        <Border Name="Container" UseLayoutRounding="True" CornerRadius="4" Height="34" Width="246" Padding="8,6,8,7" Background="#2d2d2d" BorderThickness="1">
            <Border.BorderBrush>
                <LinearGradientBrush StartPoint="1,0">
                    <GradientStop Offset="0.94" Color="#303030" />
                    <GradientStop Offset="0.98" x:Name="BottomStop" Color="#9a9a9a" />
                </LinearGradientBrush>
            </Border.BorderBrush>
            <Grid>
                <TextBlock Name="PasswordText" FontSize="14" Margin="2,1,0,0" FontWeight="Normal" Foreground="#969696" Text="Password" />
                <ScrollViewer Name="PART_ContentHost" VerticalAlignment="Top" HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Disabled" />
            </Grid>
        </Border>
        <ControlTemplate.Triggers>
            <EventTrigger RoutedEvent="MouseEnter">
                <BeginStoryboard>
                    <Storyboard>
                        <ColorAnimation Duration="0" Storyboard.TargetName="Container" Storyboard.TargetProperty="Background.Color" To="#323232" />
                    </Storyboard>
                </BeginStoryboard>
            </EventTrigger>
            <EventTrigger RoutedEvent="MouseLeave">
                <BeginStoryboard>
                    <Storyboard>
                        <ColorAnimation Duration="0" Storyboard.TargetName="Container" Storyboard.TargetProperty="Background.Color" To="#2d2d2d" />
                    </Storyboard>
                </BeginStoryboard>
            </EventTrigger>
            <EventTrigger RoutedEvent="GotKeyboardFocus">
                <BeginStoryboard>
                    <Storyboard>
                        <ThicknessAnimation Duration="0" Storyboard.TargetName="Container" Storyboard.TargetProperty="BorderThickness" To="1,1,1,2.3" />
                        <ThicknessAnimation Duration="0" Storyboard.TargetName="Container" Storyboard.TargetProperty="Padding" To="8,6,8,4.7" />
                        <ColorAnimation Duration="0" Storyboard.TargetName="BottomStop" Storyboard.TargetProperty="Color" To="#4cc2ff" />
                        <DoubleAnimation Duration="0" Storyboard.TargetName="BottomStop" Storyboard.TargetProperty="Offset" To="0.94" />
                        <DoubleAnimation Duration="0" Storyboard.TargetName="PasswordText" Storyboard.TargetProperty="Opacity" To="0.65" />
                        <DoubleAnimation Duration="0" Storyboard.TargetName="Container" Storyboard.TargetProperty="Background.Opacity" To="0" />
                    </Storyboard>
                </BeginStoryboard>
            </EventTrigger>
            <EventTrigger RoutedEvent="LostKeyboardFocus">
                <BeginStoryboard>
                    <Storyboard>
                        <ThicknessAnimation Duration="0" Storyboard.TargetName="Container" Storyboard.TargetProperty="BorderThickness" To="1" />
                        <ThicknessAnimation Duration="0" Storyboard.TargetName="Container" Storyboard.TargetProperty="Padding" To="8,6,8,7" />
                        <ColorAnimation Duration="0" Storyboard.TargetName="BottomStop" Storyboard.TargetProperty="Color" To="#9a9a9a" />
                        <DoubleAnimation Duration="0" Storyboard.TargetName="BottomStop" Storyboard.TargetProperty="Offset" To="0.98" />
                        <DoubleAnimation Duration="0" Storyboard.TargetName="PasswordText" Storyboard.TargetProperty="Opacity" To="1" />
                        <DoubleAnimation Duration="0" Storyboard.TargetName="Container" Storyboard.TargetProperty="Background.Opacity" To="1" />
                    </Storyboard>
                </BeginStoryboard>
            </EventTrigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>
