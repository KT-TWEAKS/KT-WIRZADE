    <ControlTemplate x:Key="SearchBox" TargetType="{x:Type TextBox}">
        <Border Name="Container" UseLayoutRounding="True" CornerRadius="5" Height="32" Padding="6,5,8,6" Background="#38383a">
            <StackPanel Orientation="Horizontal" Cursor="IBeam">
                <wpf:SymbolIcon UIElement.RenderTransformOrigin="0.5,0.5" UIElement.SnapsToDevicePixels="False" TextBlock.FontWeight="SemiBold" RenderOptions.EdgeMode="Aliased" TextOptions.TextFormattingMode="Display" TextOptions.TextRenderingMode="Aliased" TextBlock.Foreground="#888888" wpf:SymbolIcon.Symbol="Search" TextBlock.FontSize="14" FrameworkElement.Margin="4,3,0,0">
                    <UIElement.RenderTransform>
                        <ScaleTransform ScaleX="-1" />
                    </UIElement.RenderTransform>
                </wpf:SymbolIcon>
                <Grid Margin="7,0,0,0">
                    <TextBlock Name="BackgroundText" FontSize="14" Margin="2,1,0,0" FontWeight="Normal" Foreground="#777777" Text="Search" />
                    <ScrollViewer Name="PART_ContentHost" VerticalAlignment="Top" Margin="0,0,0,0" HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Disabled" />
                </Grid>
            </StackPanel>
        </Border>
        <ControlTemplate.Triggers>
            <EventTrigger RoutedEvent="GotKeyboardFocus">
                <BeginStoryboard>
                    <Storyboard>
                        <ColorAnimation Duration="0" Storyboard.TargetName="Container" Storyboard.TargetProperty="Background.Color" To="#353536" />
                    </Storyboard>
                </BeginStoryboard>
            </EventTrigger>
            <EventTrigger RoutedEvent="LostKeyboardFocus">
                <BeginStoryboard>
                    <Storyboard>
                        <ColorAnimation Duration="0" Storyboard.TargetName="Container" Storyboard.TargetProperty="Background.Color" To="#38383a" />
                    </Storyboard>
                </BeginStoryboard>
            </EventTrigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>
    <ControlTemplate x:Key="TextDropDownTemplate" TargetType="{x:Type Button}">
        <Border Name="BoxContainer" UseLayoutRounding="True" CornerRadius="5" BorderBrush="#1c1d1e" BorderThickness="1" Background="#31353a" Height="45" VerticalAlignment="Top" Padding="9,0,10,0">
            <Grid VerticalAlignment="Top">
                <StackPanel Name="Content" Orientation="Horizontal" VerticalAlignment="Top" HorizontalAlignment="Left" Margin="0,10,0,2">
                    <ContentPresenter />
                    <wpf:SymbolIcon TextBlock.FontSize="18" wpf:SymbolIcon.Symbol="ContactCardRibbon" TextBlock.Foreground="#FFFFFFFF" FrameworkElement.Margin="10,2,00,0" />
                    <TextBlock FontSize="14" Margin="23,2,0,0" Foreground="#FFFFFFFF" Text="{Binding Title}" />
                </StackPanel>
                <wpf:SymbolIcon wpf:SymbolIcon.Name="Chevron" FrameworkElement.HorizontalAlignment="Right" TextBlock.FontSize="19" wpf:SymbolIcon.Symbol="ChevronDown" TextBlock.Foreground="#FFFFFFFF" FrameworkElement.Margin="0,13,5,0" />
            </Grid>
        </Border>
        <ControlTemplate.Triggers>
            <EventTrigger RoutedEvent="MouseEnter">
                <EventTrigger.Actions>
                    <BeginStoryboard>
                        <Storyboard>
                            <ColorAnimation Storyboard.TargetName="BoxContainer" Storyboard.TargetProperty="Background.Color" To="#393e44" Duration="0:0:0.05" />
                        </Storyboard>
                    </BeginStoryboard>
                </EventTrigger.Actions>
            </EventTrigger>
            <EventTrigger RoutedEvent="MouseLeave">
                <EventTrigger.Actions>
                    <BeginStoryboard>
                        <Storyboard>
                            <ColorAnimation Storyboard.TargetName="BoxContainer" Storyboard.TargetProperty="Background.Color" To="#31353a" Duration="0:0:0.05" />
                        </Storyboard>
                    </BeginStoryboard>
                </EventTrigger.Actions>
            </EventTrigger>
            <EventTrigger RoutedEvent="PreviewMouseLeftButtonDown">
                <EventTrigger.Actions>
                    <BeginStoryboard>
                        <Storyboard>
                            <DoubleAnimation Duration="0:0:0.0" To="0.6" Storyboard.TargetName="Content" Storyboard.TargetProperty="Opacity" />
                        </Storyboard>
                    </BeginStoryboard>
                </EventTrigger.Actions>
            </EventTrigger>
            <EventTrigger RoutedEvent="PreviewMouseLeftButtonUp">
                <EventTrigger.Actions>
                    <BeginStoryboard>
                        <Storyboard>
                            <DoubleAnimation Duration="0:0:0.0" To="1" Storyboard.TargetName="Content" Storyboard.TargetProperty="Opacity" />
                        </Storyboard>
                    </BeginStoryboard>
                </EventTrigger.Actions>
            </EventTrigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>
    <Style x:Key="ContentBox" TargetType="{x:Type Border}">
        <Setter Property="Border.Padding" Value="15,15,17,15" />
        <Setter Property="Height" Value="74" />
        <Setter Property="Background" Value="#2a2b2c" />
        <Setter Property="Border.CornerRadius" Value="5" />
        <Setter Property="FrameworkElement.UseLayoutRounding" Value="True" />
        <Setter Property="BorderBrush" Value="{DynamicResource ContentBoxBorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="HorizontalAlignment" Value="Stretch" />
    </Style>
    <Style x:Key="ContentBoxButton" TargetType="{x:Type Button}">
        <Setter Property="Padding" Value="11,4,11,4" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="FrameworkElement.UseLayoutRounding" Value="True" />
        <Setter Property="FrameworkElement.OverridesDefaultStyle" Value="True" />
        <Setter Property="BorderBrush" Value="#3e3f40" />
        <Setter Property="Foreground" Value="#393a3b" />
        <Setter Property="Background" Value="#373738" />
        <Setter Property="UIElement.Opacity" Value="1" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type Button}">
                    <Border Name="MainBorder" Padding="{TemplateBinding Control.Padding}" Height="32" CornerRadius="4" BorderThickness="{TemplateBinding Control.BorderThickness}" Background="{TemplateBinding Control.Background}">
                        <Border.BorderBrush>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="0,0.14">
                                <GradientStop Offset="0.25" Color="{Binding BorderBrush.Color, RelativeSource={RelativeSource TemplatedParent}}" />
                                <GradientStop Offset="0.75" Color="{Binding Foreground.Color, RelativeSource={RelativeSource TemplatedParent}}" />
                            </LinearGradientBrush>
                        </Border.BorderBrush>
                        <ContentPresenter Name="Content" Opacity="{TemplateBinding UIElement.Opacity}" />
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <EventTrigger RoutedEvent="PreviewMouseLeftButtonDown">
                <EventTrigger.Actions>
                    <BeginStoryboard Name="ClickBoard">
                        <Storyboard>
                            <DoubleAnimationUsingKeyFrames Duration="0:0:0.08" Storyboard.TargetProperty="Opacity">
                                <DoubleAnimationUsingKeyFrames.KeyFrames>
                                    <LinearDoubleKeyFrame Value="0.85" KeyTime="0:0:0.08" />
                                    <LinearDoubleKeyFrame Value="1" KeyTime="0:0:0.08" />
                                </DoubleAnimationUsingKeyFrames.KeyFrames>
                            </DoubleAnimationUsingKeyFrames>
                            <ColorAnimation Duration="0:0:0.1" To="#404041" Storyboard.TargetProperty="BorderBrush.Color" />
                            <ColorAnimation Duration="0:0:0.1" To="#373839" Storyboard.TargetProperty="Background.Color" />
                        </Storyboard>
                    </BeginStoryboard>
                </EventTrigger.Actions>
            </EventTrigger>
            <EventTrigger RoutedEvent="PreviewMouseLeftButtonUp">
                <EventTrigger.Actions>
                    <BeginStoryboard>
                        <Storyboard>
                            <ColorAnimation Duration="0:0:0.1" To="#444546" Storyboard.TargetProperty="BorderBrush.Color" />
                            <ColorAnimation Duration="0:0:0.1" To="#424344" Storyboard.TargetProperty="Background.Color" />
                        </Storyboard>
                    </BeginStoryboard>
                </EventTrigger.Actions>
            </EventTrigger>
            <EventTrigger RoutedEvent="MouseEnter">
                <EventTrigger.Actions>
                    <BeginStoryboard>
                        <Storyboard>
                            <ColorAnimation Duration="0:0:0.035" To="#424344" Storyboard.TargetProperty="Background.Color" />
                            <ColorAnimation Duration="0:0:0.035" To="#444546" Storyboard.TargetProperty="BorderBrush.Color" />
                            <ColorAnimation Duration="0:0:0.035" To="#404041" Storyboard.TargetProperty="Foreground.Color" />
                        </Storyboard>
                    </BeginStoryboard>
                </EventTrigger.Actions>
            </EventTrigger>
            <EventTrigger RoutedEvent="MouseLeave">
                <EventTrigger.Actions>
                    <StopStoryboard BeginStoryboardName="ClickBoard" />
                    <BeginStoryboard>
                        <Storyboard>
                            <ColorAnimation Duration="0:0:0.035" To="#373738" Storyboard.TargetProperty="Background.Color" />
                            <ColorAnimation Duration="0:0:0.035" To="#3e3f40" Storyboard.TargetProperty="BorderBrush.Color" />
                            <ColorAnimation Duration="0:0:0.035" To="#393a3b" Storyboard.TargetProperty="Foreground.Color" />
                        </Storyboard>
                    </BeginStoryboard>
                </EventTrigger.Actions>
            </EventTrigger>
            <MultiTrigger>
                <MultiTrigger.Conditions>
                    <Condition Property="IsEnabled" Value="False" />
                    <Condition Property="UIElement.IsMouseOver" Value="False" />
                </MultiTrigger.Conditions>
                <TriggerBase.EnterActions>
                    <BeginStoryboard>
                        <Storyboard>
                            <ColorAnimation Duration="0:0:0.2" To="#393a3b" Storyboard.TargetProperty="BorderBrush.Color" />
                            <ColorAnimation Duration="0:0:0.2" To="#262829" Storyboard.TargetProperty="Background.Color" />
