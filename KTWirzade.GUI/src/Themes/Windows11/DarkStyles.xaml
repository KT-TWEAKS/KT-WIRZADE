<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" 
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" 
                    xmlns:local="clr-namespace:KTWirzade.GUI" 
                    xmlns:wpf="clr-namespace:FluentIcons.Wpf;assembly=FluentIcons.Wpf" 
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">

    <Style x:Key="SpecialButton" TargetType="{x:Type Button}">
        <Setter Property="Height" Value="22" />
        <Setter Property="MinWidth" Value="78" />
        <Setter Property="Width" Value="78" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type Button}">
                    <Border Name="Container" UseLayoutRounding="True" Height="{TemplateBinding FrameworkElement.Height}" CornerRadius="3" BorderThickness="1" Background="#373738">
                        <Border.BorderBrush>
                            <LinearGradientBrush StartPoint="1,0">
                                <GradientStop Offset="0.885" Color="#222222" />
                                <GradientStop Offset="0.99" Color="#222222" />
                            </LinearGradientBrush>
                        </Border.BorderBrush>
                        <Grid>
                            <Rectangle Name="Rect" Margin="0,0,0,0" Fill="#373738" RadiusX="2" RadiusY="2" />
                            <Grid Name="ContentContainer">
                                <ContentPresenter Name="Content" HorizontalAlignment="Center" Margin="0,1,0,0" />
                            </Grid>
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <EventTrigger RoutedEvent="MouseEnter">
                            <EventTrigger.Actions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <ColorAnimation Storyboard.TargetName="Container" Storyboard.TargetProperty="Background.Color" To="#424344" Duration="0:0:0.05" />
                                        <ColorAnimation Storyboard.TargetName="Rect" Storyboard.TargetProperty="Fill.Color" To="#424344" Duration="0:0:0.05" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </EventTrigger.Actions>
                        </EventTrigger>
                        <EventTrigger RoutedEvent="MouseLeave">
                            <EventTrigger.Actions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <ColorAnimation Storyboard.TargetName="Container" Storyboard.TargetProperty="Background.Color" To="#373738" Duration="0:0:0.05" />
                                        <ColorAnimation Storyboard.TargetName="Rect" Storyboard.TargetProperty="Fill.Color" To="#373738" Duration="0:0:0.05" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </EventTrigger.Actions>
                        </EventTrigger>
                        <EventTrigger RoutedEvent="Click">
                            <EventTrigger.Actions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="Content" Duration="0:0:0.07" Storyboard.TargetProperty="Opacity">
                                            <LinearDoubleKeyFrame Value="0.7" KeyTime="0:0:0" />
                                            <LinearDoubleKeyFrame Value="0.7" KeyTime="0:0:0.07" />
                                            <LinearDoubleKeyFrame Value="1" KeyTime="0:0:0.07" />
                                        </DoubleAnimationUsingKeyFrames>
                                    </Storyboard>
                                </BeginStoryboard>
                            </EventTrigger.Actions>
                        </EventTrigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <TriggerBase.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Duration="0:0:0.25" To="0.5" Storyboard.TargetName="ContentContainer" Storyboard.TargetProperty="Opacity" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </TriggerBase.EnterActions>
                            <TriggerBase.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Duration="0:0:0.27" To="1" Storyboard.TargetName="ContentContainer" Storyboard.TargetProperty="Opacity" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </TriggerBase.ExitActions>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style x:Key="{x:Type CheckBox}" TargetType="{x:Type CheckBox}">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type CheckBox}">
                    <StackPanel Orientation="Horizontal">
                        <Grid Width="21" Height="21">
                            <Border Name="FillBorder" CornerRadius="5" Background="#49a7d8" />
                            <Border Name="MainBorder" CornerRadius="4" Background="#00FFFFFF" BorderBrush="#49a7d8" BorderThickness="1">
                                <wpf:SymbolIcon wpf:SymbolIcon.Name="Icon" FrameworkElement.Margin="0,2,0,0" TextBlock.FontWeight="Bold" TextBlock.FontSize="14" UIElement.Opacity="1" wpf:SymbolIcon.Symbol="Checkmark" TextBlock.Foreground="#FF000000" />
                            </Border>
                            <Border Name="CheckedOverlay" Opacity="0" Background="#FF000000" CornerRadius="5" />
                            <Border Name="UncheckedOverlay" Opacity="0" Background="#00FFFFFF" Margin="1" CornerRadius="6" />
                        </Grid>
                        <TextBlock Text="     " Width="15" />
                        <ContentPresenter VerticalAlignment="Top" HorizontalAlignment="Left" MinHeight="21" Margin="0,1,0,0" />
                    </StackPanel>
                    <ControlTemplate.Triggers>
                        <EventTrigger RoutedEvent="Checked">
                            <BeginStoryboard>
                                <Storyboard>
                                    <ColorAnimation Storyboard.TargetName="FillBorder" Storyboard.TargetProperty="Background.Color" To="#49a7d8" Duration="0:0:0.08" />
                                    <ColorAnimation Storyboard.TargetName="MainBorder" Storyboard.TargetProperty="BorderBrush.Color" To="#49a7d8" Duration="0:0:0.08" />
                                    <DoubleAnimation Storyboard.TargetName="Icon" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.1" />
                                    <ColorAnimation Storyboard.TargetName="UncheckedOverlay" Storyboard.TargetProperty="Background.Color" To="Transparent" Duration="0:0:0" />
                                    <ColorAnimation Storyboard.TargetName="CheckedOverlay" Storyboard.TargetProperty="Background.Color" To="Black" Duration="0:0:0" />
                                </Storyboard>
                            </BeginStoryboard>
                        </EventTrigger>
                        <EventTrigger RoutedEvent="Unchecked">
                            <BeginStoryboard>
                                <Storyboard>
                                    <ColorAnimation Storyboard.TargetName="FillBorder" Storyboard.TargetProperty="Background.Color" To="Transparent" Duration="0:0:0.06" />
                                    <ColorAnimation Storyboard.TargetName="MainBorder" Storyboard.TargetProperty="BorderBrush.Color" To="#a3a3a3" Duration="0:0:0.06" />
                                    <DoubleAnimation Storyboard.TargetName="Icon" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.06" />
                                    <ColorAnimation Storyboard.TargetName="CheckedOverlay" Storyboard.TargetProperty="Background.Color" To="Transparent" Duration="0:0:0" />
                                    <ColorAnimation Storyboard.TargetName="UncheckedOverlay" Storyboard.TargetProperty="Background.Color" To="White" Duration="0:0:0" />
                                </Storyboard>
                            </BeginStoryboard>
                        </EventTrigger>
                        <EventTrigger RoutedEvent="MouseEnter">
                            <BeginStoryboard>
                                <Storyboard>
                                    <DoubleAnimation Storyboard.TargetName="CheckedOverlay" Storyboard.TargetProperty="Opacity" To="0.05" Duration="0:0:0.03" />
                                    <DoubleAnimation Storyboard.TargetName="UncheckedOverlay" Storyboard.TargetProperty="Opacity" To="0.05" Duration="0:0:0.03" />
                                </Storyboard>
                            </BeginStoryboard>
                        </EventTrigger>
                        <EventTrigger RoutedEvent="MouseLeave">
                            <BeginStoryboard>
                                <Storyboard>
                                    <DoubleAnimation Storyboard.TargetName="CheckedOverlay" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.03" />
                                    <DoubleAnimation Storyboard.TargetName="UncheckedOverlay" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.03" />
                                </Storyboard>
                            </BeginStoryboard>
                        </EventTrigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
