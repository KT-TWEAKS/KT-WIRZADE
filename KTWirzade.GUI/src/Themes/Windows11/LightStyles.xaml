    <ControlTemplate x:Key="SearchBox" TargetType="{x:Type TextBox}">
        <Border Name="Container" UseLayoutRounding="True" CornerRadius="5" Height="32" Padding="6,5,8,6" Background="#eceef2">
            <StackPanel Orientation="Horizontal" Cursor="IBeam">
                <wpf:SymbolIcon UIElement.RenderTransformOrigin="0.5,0.5" UIElement.SnapsToDevicePixels="False" TextBlock.FontWeight="SemiBold" RenderOptions.EdgeMode="Aliased" TextOptions.TextFormattingMode="Display" TextOptions.TextRenderingMode="Aliased" TextBlock.Foreground="#888888" wpf:SymbolIcon.Symbol="Search" TextBlock.FontSize="14" FrameworkElement.Margin="4,3,0,0">
                    <UIElement.RenderTransform>
                        <ScaleTransform ScaleX="-1" />
                    </UIElement.RenderTransform>
                </wpf:SymbolIcon>
                <Grid Margin="7,0,0,0">
                    <TextBlock Name="BackgroundText" FontSize="14" Margin="2,1,0,0" FontWeight="Normal" Foreground="#777777" Text="Search" />
                    <ScrollViewer Name="PART_ContentHost" VerticalAlignment="Top" Margin="0,0,0,0" HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Disabled" />
                </Grid>
            </StackPanel>
        </Border>
        <ControlTemplate.Triggers>
            <EventTrigger RoutedEvent="GotKeyboardFocus">
                <BeginStoryboard>
                    <Storyboard>
                        <ColorAnimation Duration="0" Storyboard.TargetName="Container" Storyboard.TargetProperty="Background.Color" To="#e7e9ed" />
                    </Storyboard>
                </BeginStoryboard>
            </EventTrigger>
            <EventTrigger RoutedEvent="LostKeyboardFocus">
                <BeginStoryboard>
                    <Storyboard>
                        <ColorAnimation Duration="0" Storyboard.TargetName="Container" Storyboard.TargetProperty="Background.Color" To="#eceef2" />
                    </Storyboard>
                </BeginStoryboard>
            </EventTrigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>
    <ControlTemplate x:Key="TextDropDownTemplate" TargetType="{x:Type Button}">
        <Border Name="BoxContainer" UseLayoutRounding="True" CornerRadius="5" BorderBrush="#e6e7ec" BorderThickness="1" Background="#f6fafc" Height="45" VerticalAlignment="Top" Padding="9,0,10,0">
            <Grid VerticalAlignment="Top">
                <StackPanel Name="Content" Orientation="Horizontal" VerticalAlignment="Top" HorizontalAlignment="Left" Margin="0,10,0,2">
                    <ContentPresenter />
                    <wpf:SymbolIcon TextBlock.FontSize="18" wpf:SymbolIcon.Symbol="ContactCardRibbon" TextBlock.Foreground="#FF000000" FrameworkElement.Margin="10,2,00,0" />
                    <TextBlock FontSize="14" Margin="23,2,0,0" Foreground="#FF000000" Text="{Binding Title}" />
                </StackPanel>
                <wpf:SymbolIcon wpf:SymbolIcon.Name="Chevron" FrameworkElement.VerticalAlignment="Top" FrameworkElement.HorizontalAlignment="Right" TextBlock.FontSize="19" wpf:SymbolIcon.Symbol="ChevronDown" TextBlock.Foreground="#FF000000" FrameworkElement.Margin="0,13,5,0" />
            </Grid>
        </Border>
        <ControlTemplate.Triggers>
            <EventTrigger RoutedEvent="MouseEnter">
                <EventTrigger.Actions>
                    <BeginStoryboard>
                        <Storyboard>
                            <ColorAnimation Storyboard.TargetName="BoxContainer" Storyboard.TargetProperty="Background.Color" To="#f0f4f6" Duration="0:0:0.05" />
                        </Storyboard>
                    </BeginStoryboard>
                </EventTrigger.Actions>
            </EventTrigger>
            <EventTrigger RoutedEvent="MouseLeave">
                <EventTrigger.Actions>
                    <BeginStoryboard>
                        <Storyboard>
                            <ColorAnimation Storyboard.TargetName="BoxContainer" Storyboard.TargetProperty="Background.Color" To="#f6fafc" Duration="0:0:0.05" />
                        </Storyboard>
                    </BeginStoryboard>
                </EventTrigger.Actions>
            </EventTrigger>
            <EventTrigger RoutedEvent="PreviewMouseLeftButtonDown">
                <EventTrigger.Actions>
                    <BeginStoryboard>
                        <Storyboard>
                            <DoubleAnimation Duration="0:0:0.0" To="0.6" Storyboard.TargetName="Content" Storyboard.TargetProperty="Opacity" />
                        </Storyboard>
                    </BeginStoryboard>
                </EventTrigger.Actions>
            </EventTrigger>
            <EventTrigger RoutedEvent="PreviewMouseLeftButtonUp">
                <EventTrigger.Actions>
                    <BeginStoryboard>
                        <Storyboard>
                            <DoubleAnimation Duration="0:0:0.0" To="1" Storyboard.TargetName="Content" Storyboard.TargetProperty="Opacity" />
                        </Storyboard>
                    </BeginStoryboard>
                </EventTrigger.Actions>
            </EventTrigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>
    <Style x:Key="ContentBox" TargetType="{x:Type Border}">
        <Setter Property="Border.Padding" Value="15,15,17,15" />
        <Setter Property="Height" Value="74" />
        <Setter Property="Background" Value="#fbfbfc" />
        <Setter Property="FrameworkElement.UseLayoutRounding" Value="True" />
        <Setter Property="Border.CornerRadius" Value="5" />
        <Setter Property="BorderBrush" Value="{DynamicResource ContentBoxBorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="HorizontalAlignment" Value="Stretch" />
    </Style>
    <Style x:Key="ContentBoxButton" TargetType="{x:Type Button}">
        <Setter Property="Padding" Value="11,4,11,4" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="FrameworkElement.UseLayoutRounding" Value="True" />
        <Setter Property="FrameworkElement.OverridesDefaultStyle" Value="True" />
        <Setter Property="BorderBrush" Value="#d2d3d4" />
        <Setter Property="UIElement.Opacity" Value="1" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type Button}">
                    <Border Name="MainBorder" Padding="{TemplateBinding Control.Padding}" Height="32" CornerRadius="4" BorderThickness="{TemplateBinding Control.BorderThickness}" Background="#fefefe">
                        <Border.BorderBrush>
                            <LinearGradientBrush StartPoint="0,0.86" EndPoint="0,1">
                                <GradientStop Color="#ebedee" Offset="0" />
                                <GradientStop x:Name="BottomColor" Offset="0.75" Color="{Binding BorderBrush.Color, RelativeSource={RelativeSource TemplatedParent}}" />
                            </LinearGradientBrush>
                        </Border.BorderBrush>
                        <ContentPresenter Name="Content" Opacity="{TemplateBinding UIElement.Opacity}" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <EventTrigger RoutedEvent="MouseEnter">
                            <EventTrigger.Actions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <ColorAnimation Duration="0:0:0" To="#fafafb" Storyboard.TargetName="MainBorder" Storyboard.TargetProperty="Background.Color" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </EventTrigger.Actions>
                        </EventTrigger>
                        <EventTrigger RoutedEvent="MouseLeave">
                            <EventTrigger.Actions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <ColorAnimation Duration="0:0:0" To="#fefefe" Storyboard.TargetName="MainBorder" Storyboard.TargetProperty="Background.Color" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </EventTrigger.Actions>
                        </EventTrigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <TriggerBase.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <ColorAnimation Duration="0:0:0.08" To="#ebedee" Storyboard.TargetName="BottomColor" Storyboard.TargetProperty="Color" />
                                        <ColorAnimation Duration="0:0:0.08" To="#fafbfc" Storyboard.TargetName="MainBorder" Storyboard.TargetProperty="Background.Color" />
                                        <DoubleAnimation Duration="0:0:0.08" To="0.4" Storyboard.TargetName="Content" Storyboard.TargetProperty="Opacity" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </TriggerBase.EnterActions>
                            <TriggerBase.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <ColorAnimation Duration="0:0:0.08" To="#d2d3d4" Storyboard.TargetName="BottomColor" Storyboard.TargetProperty="Color" />
                                        <ColorAnimation Duration="0:0:0.08" To="#fefefe" Storyboard.TargetName="MainBorder" Storyboard.TargetProperty="Background.Color" />
                                        <DoubleAnimation Duration="0:0:0.08" To="1" Storyboard.TargetName="Content" Storyboard.TargetProperty="Opacity" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </TriggerBase.ExitActions>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
