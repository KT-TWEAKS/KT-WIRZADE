    <Style x:Key="PulseButton" TargetType="{x:Type Button}">
        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="FrameworkElement.UseLayoutRounding" Value="True" />
        <Setter Property="MinWidth" Value="78" />
        <Setter Property="Padding" Value="19,2" />
        <Setter Property="RenderOptions.EdgeMode" Value="Aliased" />
        <Setter Property="Height" Value="24" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type Button}">
                    <FrameworkTemplate.Resources>
                        <ResourceDictionary>
                            <Storyboard x:Key="UnfocusedBorder" TargetName="MainBorder">
                                <ColorAnimation Storyboard.TargetProperty="(Border.BorderBrush).(GradientBrush.GradientStops)[0].(GradientStop.Color)" Duration="0:0:0.25" To="#d0d0d0" />
                                <ColorAnimation Storyboard.TargetProperty="(Border.BorderBrush).(GradientBrush.GradientStops)[1].(GradientStop.Color)" Duration="0:0:0.25" To="#d9d9d9" />
                                <ColorAnimation Storyboard.TargetProperty="(Border.BorderBrush).(GradientBrush.GradientStops)[2].(GradientStop.Color)" Duration="0:0:0.25" To="#d9d9d9" />
                                <ColorAnimation Storyboard.TargetProperty="(Border.BorderBrush).(GradientBrush.GradientStops)[3].(GradientStop.Color)" Duration="0:0:0.25" To="#e5e5e5" />
                                <ColorAnimation Storyboard.TargetProperty="(Border.BorderBrush).(GradientBrush.GradientStops)[4].(GradientStop.Color)" Duration="0:0:0.25" To="#e5e5e5" />
                                <ColorAnimation Storyboard.TargetProperty="(Border.BorderBrush).(GradientBrush.GradientStops)[5].(GradientStop.Color)" Duration="0:0:0.25" To="#cacaca" />
                                <ColorAnimation Storyboard.TargetProperty="(Border.BorderBrush).(GradientBrush.GradientStops)[6].(GradientStop.Color)" Duration="0:0:0.25" To="#cacaca" />
                                <ColorAnimation Storyboard.TargetName="OuterFadeBrush" Storyboard.TargetProperty="Color" Duration="0:0:0.25" To="#eaeaea" />
                                <ColorAnimation Storyboard.TargetName="InnerFadeBrush" Storyboard.TargetProperty="Color" Duration="0:0:0.25" To="#ececec" />
                                <DoubleAnimation Storyboard.TargetName="OuterFadeBrush" Storyboard.TargetProperty="Opacity" Duration="0:0:0.25" To="0.25" />
                                <DoubleAnimation Storyboard.TargetName="InnerFadeBrush" Storyboard.TargetProperty="Opacity" Duration="0:0:0.25" To="0.35" />
                            </Storyboard>
                            <Storyboard x:Key="FocusedBorder" TargetName="MainBorder">
                                <ColorAnimation Storyboard.TargetProperty="(Border.BorderBrush).(GradientBrush.GradientStops)[0].(GradientStop.Color)" Duration="0:0:0.25" To="#0078d4" />
                                <ColorAnimation Storyboard.TargetProperty="(Border.BorderBrush).(GradientBrush.GradientStops)[1].(GradientStop.Color)" Duration="0:0:0.25" To="#9dcaed" />
                                <ColorAnimation Storyboard.TargetProperty="(Border.BorderBrush).(GradientBrush.GradientStops)[2].(GradientStop.Color)" Duration="0:0:0.25" To="#9dcaed" />
                                <ColorAnimation Storyboard.TargetProperty="(Border.BorderBrush).(GradientBrush.GradientStops)[3].(GradientStop.Color)" Duration="0:0:0.25" To="#dfe8f4" />
                                <ColorAnimation Storyboard.TargetProperty="(Border.BorderBrush).(GradientBrush.GradientStops)[4].(GradientStop.Color)" Duration="0:0:0.25" To="#63b0ea" />
                                <ColorAnimation Storyboard.TargetProperty="(Border.BorderBrush).(GradientBrush.GradientStops)[5].(GradientStop.Color)" Duration="0:0:0.25" To="#004274" />
                                <ColorAnimation Storyboard.TargetProperty="(Border.BorderBrush).(GradientBrush.GradientStops)[6].(GradientStop.Color)" Duration="0:0:0.25" To="#004274" />
                                <ColorAnimation Storyboard.TargetName="OuterFadeBrush" Storyboard.TargetProperty="Color" Duration="0:0:0.25" To="#0091ff" />
                                <ColorAnimation Storyboard.TargetName="InnerFadeBrush" Storyboard.TargetProperty="Color" Duration="0:0:0.25" To="#49a8f1" />
                                <DoubleAnimation Storyboard.TargetName="OuterFadeBrush" Storyboard.TargetProperty="Opacity" Duration="0:0:0.25" To="0.9" />
                                <DoubleAnimation Storyboard.TargetName="InnerFadeBrush" Storyboard.TargetProperty="Opacity" Duration="0:0:0.25" To="0.30" />
                            </Storyboard>
                            <Storyboard x:Key="GrayedBorder" TargetName="MainBorder">
                                <ColorAnimation Storyboard.TargetProperty="(Border.BorderBrush).(GradientBrush.GradientStops)[0].(GradientStop.Color)" Duration="0:0:0.2" To="#e9e9e9" />
                                <ColorAnimation Storyboard.TargetProperty="(Border.BorderBrush).(GradientBrush.GradientStops)[1].(GradientStop.Color)" Duration="0:0:0.2" To="#f0f0f0" />
                                <ColorAnimation Storyboard.TargetProperty="(Border.BorderBrush).(GradientBrush.GradientStops)[2].(GradientStop.Color)" Duration="0:0:0.2" To="#f0f0f0" />
                                <ColorAnimation Storyboard.TargetProperty="(Border.BorderBrush).(GradientBrush.GradientStops)[3].(GradientStop.Color)" Duration="0:0:0.2" To="#f0f0f0" />
                                <ColorAnimation Storyboard.TargetProperty="(Border.BorderBrush).(GradientBrush.GradientStops)[4].(GradientStop.Color)" Duration="0:0:0.2" To="#f0f0f0" />
                                <ColorAnimation Storyboard.TargetProperty="(Border.BorderBrush).(GradientBrush.GradientStops)[5].(GradientStop.Color)" Duration="0:0:0.2" To="#e9e9e9" />
                                <ColorAnimation Storyboard.TargetProperty="(Border.BorderBrush).(GradientBrush.GradientStops)[6].(GradientStop.Color)" Duration="0:0:0.2" To="#f0f0f0" />
                                <ColorAnimation Storyboard.TargetName="OuterFadeBrush" Storyboard.TargetProperty="Color" Duration="0:0:0.2" To="#ededed" />
                                <ColorAnimation Storyboard.TargetName="InnerFadeBrush" Storyboard.TargetProperty="Color" Duration="0:0:0.2" To="#ededed" />
                                <DoubleAnimation Storyboard.TargetName="OuterFadeBrush" Storyboard.TargetProperty="Opacity" Duration="0:0:0.2" To="0.35" />
                                <DoubleAnimation Storyboard.TargetName="InnerFadeBrush" Storyboard.TargetProperty="Opacity" Duration="0:0:0.2" To="0.50" />
                            </Storyboard>
                        </ResourceDictionary>
                    </FrameworkTemplate.Resources>
                    <Grid Name="ButtonContainer">
                        <Border Name="CornerOuterFade" Opacity="0.25" CornerRadius="3" BorderThickness="1">
                            <Border.BorderBrush>
                                <SolidColorBrush x:Name="OuterFadeBrush" Opacity="0.5" Color="#cbcbcb" />
                            </Border.BorderBrush>
                        </Border>
                        <Border Name="CornerInnerFade" CornerRadius="4" BorderThickness="1" Background="#fdfdfd">
                            <Border.BorderBrush>
                                <SolidColorBrush x:Name="InnerFadeBrush" Opacity="0.5" Color="#cbcbcb" />
                            </Border.BorderBrush>
                            <Grid>
                                <Rectangle Name="Rect1" RadiusY="2.5" RadiusX="2.5" Opacity="0">
                                    <Shape.Fill>
                                        <LinearGradientBrush StartPoint="0,-0.025" EndPoint="0,0.3">
                                            <GradientStop Color="#0034a6" Offset="0" />
                                            <GradientStop Color="#0034a6" Offset="0.1" />
                                            <GradientStop Color="Transparent" Offset="0.8" />
                                        </LinearGradientBrush>
                                    </Shape.Fill>
                                </Rectangle>
                                <Rectangle Name="Rect2" RadiusX="2.5" RadiusY="2.5" Opacity="0">
                                    <Shape.Fill>
                                        <LinearGradientBrush StartPoint="0,1.025" EndPoint="0,0.6">
                                            <GradientStop Color="#0034a6" Offset="0" />
                                            <GradientStop Color="#0034a6" Offset="0.05" />
                                            <GradientStop Color="Transparent" Offset="0.72" />
                                        </LinearGradientBrush>
                                    </Shape.Fill>
                                </Rectangle>
                                <Rectangle Name="Rect3" Height="21.5" RadiusX="2" RadiusY="1.6" Opacity="0">
                                    <Shape.Fill>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="0.5,0">
                                            <GradientStop Color="#0034a6" Offset="0" />
                                            <GradientStop Color="Transparent" Offset="0.15" />
                                        </LinearGradientBrush>
                                    </Shape.Fill>
                                </Rectangle>
                                <Rectangle Name="Rect4" Height="21.5" RadiusX="2" RadiusY="1.6" Opacity="0">
                                    <Shape.Fill>
                                        <LinearGradientBrush StartPoint="1,0" EndPoint="0.5,0">
                                            <GradientStop Color="#0034a6" Offset="0" />
                                            <GradientStop Color="Transparent" Offset="0.15" />
                                        </LinearGradientBrush>
                                    </Shape.Fill>
                                </Rectangle>
                                <ContentPresenter Name="Content" Opacity="1" HorizontalAlignment="{TemplateBinding Control.HorizontalContentAlignment}" Margin="{TemplateBinding Control.Padding}" VerticalAlignment="{TemplateBinding Control.VerticalContentAlignment}" RecognizesAccessKey="True" />
                            </Grid>
                        </Border>
                        <Border Name="MainBorder" BorderThickness="1" CornerRadius="3">
                            <Border.BorderBrush>
                                <RadialGradientBrush>
                                    <Brush.RelativeTransform>
                                        <TransformGroup>
                                            <ScaleTransform CenterX="0.5" CenterY="0.5" ScaleX="2.74" ScaleY="4.5" />
                                        </TransformGroup>
                                    </Brush.RelativeTransform>
                                    <RadialGradientBrush.GradientOrigin>
                                        <Point X="0.5" Y="0.50" />
                                    </RadialGradientBrush.GradientOrigin>
                                    <GradientStop Color="#d0d0d0" Offset="0.401" />
                                    <GradientStop Color="#d9d9d9" Offset="0.401" />
                                    <GradientStop Color="#d9d9d9" Offset="0.402" />
                                    <GradientStop Color="#e5e5e5" Offset="0.402" />
                                    <GradientStop Color="#e5e5e5" Offset="0.4065" />
                                    <GradientStop Color="#cacaca" Offset="0.4065" />
                                    <GradientStop Color="#cacaca" Offset="0.411" />
                                </RadialGradientBrush>
                            </Border.BorderBrush>
                        </Border>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <EventTrigger RoutedEvent="Grid.MouseLeftButtonDown" SourceName="ButtonContainer">
                            <EventTrigger.Actions>
                                <BeginStoryboard Name="ClickEffect">
                                    <Storyboard>
                                        <ColorAnimation Duration="0:0:0.1" To="#d5e5f2" Storyboard.TargetName="CornerInnerFade" Storyboard.TargetProperty="Background.Color" />
                                        <ColorAnimation BeginTime="0:0:0.1" Duration="0:0:0.1" To="#e0eef9" Storyboard.TargetName="CornerInnerFade" Storyboard.TargetProperty="Background.Color" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </EventTrigger.Actions>
                        </EventTrigger>
                        <Trigger Property="IsEnabled" Value="True">
                            <Setter TargetName="MainBorder" Property="Border.BorderThickness" Value="2" />
                            <TriggerBase.EnterActions>
                                <BeginStoryboard Storyboard="{StaticResource FocusedBorder}" />
                                <StopStoryboard BeginStoryboardName="MouseLeavePulse" />
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="Rect1" Storyboard.TargetProperty="Opacity" To="0.4" Duration="0:0:0:0" />
                                        <DoubleAnimation Storyboard.TargetName="Rect2" Storyboard.TargetProperty="Opacity" To="0.4" Duration="0:0:0:0" />
                                        <DoubleAnimation Storyboard.TargetName="Rect3" Storyboard.TargetProperty="Opacity" To="0.4" Duration="0:0:0:0" />
                                        <DoubleAnimation Storyboard.TargetName="Rect4" Storyboard.TargetProperty="Opacity" To="0.4" Duration="0:0:0:0" />
                                    </Storyboard>
                                </BeginStoryboard>
                                <BeginStoryboard Name="EnablePulse" HandoffBehavior="Compose">
                                    <Storyboard RepeatBehavior="Forever" BeginTime="0:0:0:0.2">
                                        <DoubleAnimationUsingKeyFrames Duration="0:0:0:1" Storyboard.TargetName="Rect1" Storyboard.TargetProperty="Opacity">
                                            <LinearDoubleKeyFrame KeyTime="0:0:0:0.5" Value="1" />
                                            <LinearDoubleKeyFrame KeyTime="0:0:0:1" Value="0.4" />
                                        </DoubleAnimationUsingKeyFrames>
                                        <DoubleAnimationUsingKeyFrames Duration="0:0:0:1" Storyboard.TargetName="Rect2" Storyboard.TargetProperty="Opacity">
                                            <LinearDoubleKeyFrame KeyTime="0:0:0:0.5" Value="1" />
                                            <LinearDoubleKeyFrame KeyTime="0:0:0:1" Value="0.4" />
                                        </DoubleAnimationUsingKeyFrames>
                                        <DoubleAnimationUsingKeyFrames Duration="0:0:0:1" Storyboard.TargetName="Rect3" Storyboard.TargetProperty="Opacity">
                                            <LinearDoubleKeyFrame KeyTime="0:0:0:0.5" Value="1" />
                                            <LinearDoubleKeyFrame KeyTime="0:0:0:1" Value="0.4" />
                                        </DoubleAnimationUsingKeyFrames>
                                        <DoubleAnimationUsingKeyFrames Duration="0:0:0:1" Storyboard.TargetName="Rect4" Storyboard.TargetProperty="Opacity">
                                            <LinearDoubleKeyFrame KeyTime="0:0:0:0.5" Value="1" />
                                            <LinearDoubleKeyFrame KeyTime="0:0:0:1" Value="0.4" />
                                        </DoubleAnimationUsingKeyFrames>
                                    </Storyboard>
                                </BeginStoryboard>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Duration="0:0:0.1" To="1" Storyboard.TargetName="Content" Storyboard.TargetProperty="Opacity" />
                                        <ColorAnimation Duration="0:0:0.1" To="#fdfdfd" Storyboard.TargetName="CornerInnerFade" Storyboard.TargetProperty="Background.Color" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </TriggerBase.EnterActions>
                            <TriggerBase.ExitActions>
                                <StopStoryboard BeginStoryboardName="EnablePulse" />
                                <StopStoryboard BeginStoryboardName="MouseLeavePulse" />
                                <BeginStoryboard Storyboard="{StaticResource UnfocusedBorder}" />
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="Rect1" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0:0" />
                                        <DoubleAnimation Storyboard.TargetName="Rect2" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0:0" />
                                        <DoubleAnimation Storyboard.TargetName="Rect3" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0:0" />
                                        <DoubleAnimation Storyboard.TargetName="Rect4" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0:0" />
                                    </Storyboard>
                                </BeginStoryboard>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Duration="0:0:0.1" To="0.65" Storyboard.TargetName="Content" Storyboard.TargetProperty="Opacity" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </TriggerBase.ExitActions>
                        </Trigger>
                        <Trigger Property="UIElement.IsMouseOver" Value="True">
                            <TriggerBase.EnterActions>
                                <StopStoryboard BeginStoryboardName="EnablePulse" />
                                <StopStoryboard BeginStoryboardName="MouseLeavePulse" />
                                <BeginStoryboard>
                                    <Storyboard>
                                        <ColorAnimation Duration="0:0:0.15" To="#e0eef9" Storyboard.TargetName="CornerInnerFade" Storyboard.TargetProperty="Background.Color" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </TriggerBase.EnterActions>
                            <TriggerBase.ExitActions>
                                <StopStoryboard BeginStoryboardName="EnablePulse" />
                                <BeginStoryboard Name="MouseLeavePulse" HandoffBehavior="Compose">
                                    <Storyboard RepeatBehavior="Forever">
                                        <DoubleAnimationUsingKeyFrames Duration="0:0:0:1" Storyboard.TargetName="Rect1" Storyboard.TargetProperty="Opacity">
                                            <LinearDoubleKeyFrame KeyTime="0:0:0:0.5" Value="1" />
                                            <LinearDoubleKeyFrame KeyTime="0:0:0:1" Value="0.4" />
                                        </DoubleAnimationUsingKeyFrames>
                                        <DoubleAnimationUsingKeyFrames Duration="0:0:0:1" Storyboard.TargetName="Rect2" Storyboard.TargetProperty="Opacity">
                                            <LinearDoubleKeyFrame KeyTime="0:0:0:0.5" Value="1" />
                                            <LinearDoubleKeyFrame KeyTime="0:0:0:1" Value="0.4" />
                                        </DoubleAnimationUsingKeyFrames>
                                        <DoubleAnimationUsingKeyFrames Duration="0:0:0:1" Storyboard.TargetName="Rect3" Storyboard.TargetProperty="Opacity">
                                            <LinearDoubleKeyFrame KeyTime="0:0:0:0.5" Value="1" />
                                            <LinearDoubleKeyFrame KeyTime="0:0:0:1" Value="0.4" />
                                        </DoubleAnimationUsingKeyFrames>
                                        <DoubleAnimationUsingKeyFrames Duration="0:0:0:1" Storyboard.TargetName="Rect4" Storyboard.TargetProperty="Opacity">
                                            <LinearDoubleKeyFrame KeyTime="0:0:0:0.5" Value="1" />
                                            <LinearDoubleKeyFrame KeyTime="0:0:0:1" Value="0.4" />
                                        </DoubleAnimationUsingKeyFrames>
                                    </Storyboard>
                                </BeginStoryboard>
                                <StopStoryboard BeginStoryboardName="ClickEffect" />
                                <BeginStoryboard>
                                    <Storyboard>
                                        <ColorAnimation Duration="0:0:0.25" To="#fdfdfd" Storyboard.TargetName="CornerInnerFade" Storyboard.TargetProperty="Background.Color" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </TriggerBase.ExitActions>
                        </Trigger>
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="UIElement.IsMouseOver" Value="False" />
                                <Condition Property="IsEnabled" Value="False" />
                            </MultiTrigger.Conditions>
                            <Setter TargetName="MainBorder" Property="Border.BorderThickness" Value="1" />
                            <TriggerBase.EnterActions>
                                <StopStoryboard BeginStoryboardName="EnablePulse" />
                                <StopStoryboard BeginStoryboardName="MouseLeavePulse" />
                            </TriggerBase.EnterActions>
                        </MultiTrigger>
                        <Trigger Property="UIElement.IsMouseOver" Value="True">
                            <TriggerBase.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <ColorAnimation Duration="0:0:0.15" To="#e0eef9" Storyboard.TargetName="CornerInnerFade" Storyboard.TargetProperty="Background.Color" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </TriggerBase.EnterActions>
                            <TriggerBase.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <ColorAnimation Duration="0:0:0.25" To="#fdfdfd" Storyboard.TargetName="CornerInnerFade" Storyboard.TargetProperty="Background.Color" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </TriggerBase.ExitActions>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
