<Grid x:Class="KTWirzade.GUI.UninstallUpdateDialog.Default"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:KTWirzade.GUI.UninstallUpdateDialog"
      xmlns:controls="clr-namespace:KTWirzade.GUI.Controls"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800">

    <Grid.ColumnDefinitions>
        <ColumnDefinition Width="395" />
        <ColumnDefinition Width="*" />
    </Grid.ColumnDefinitions>
    <Grid Name="LeftGrid" VerticalAlignment="Top" Margin="0,130,0,0" UseLayoutRounding="True">
        <Image Name="WusaSearching" Source="{DynamicResource WusaSearchingBitmap}" Style="{DynamicResource QualityImage}" Width="328" HorizontalAlignment="Center" VerticalAlignment="Center" />
        <Rectangle Name="WusaSearchingIndicator" Fill="#0F7B0F" Width="50" Height="10.5" Margin="68,100.75,0,0" VerticalAlignment="Top" HorizontalAlignment="Left" />
        <Image Name="WusaUninstalling" Source="{DynamicResource WusaUninstallingBitmap}" Style="{DynamicResource QualityImage}" Width="328" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Hidden" />
        <Image Name="WusaUninstallPrompt" Source="{DynamicResource WusaUninstallPromptBitmap}" Style="{DynamicResource QualityImage}" Width="333" HorizontalAlignment="Center" VerticalAlignment="Center" Opacity="0" RenderTransformOrigin="0.5,0.5">
            <UIElement.RenderTransform>
                <ScaleTransform x:Name="WusaUninstallPromptScaleTransform" ScaleX="0.9" ScaleY="0.9" />
            </UIElement.RenderTransform>
        </Image>
        <Border Name="YesButtonHoverEffect" Opacity="0" Height="19" Width="56" VerticalAlignment="Top" Margin="100,182,0,0" CornerRadius="1,1,1,1">
            <Border.Background>
                <SolidColorBrush Color="DodgerBlue" Opacity="0.05" />
            </Border.Background>
        </Border>
        <Image Name="MouseCursor" Style="{DynamicResource QualityImage}" Width="8" Source="{StaticResource MouseCursorBitmap}" VerticalAlignment="Top" HorizontalAlignment="Left" Visibility="Visible" Margin="176,137,0,0" />
    </Grid>
    <Grid Name="PageColumn" Column="1" Height="485" VerticalAlignment="Top" Margin="0,0,26,26">
        <Border Name="PageBackgroundBorder" Background="{DynamicResource PageBackground}" Opacity="1" CornerRadius="9,9,9,9" Margin="0,0,0,0" />
        <Border Name="PageGrid" BorderBrush="{DynamicResource PageBorderBrush}" BorderThickness="1,1,1,1" Background="#00FFFFFF" CornerRadius="8,8,8,8" Padding="29,31,29,0" />
        <StackPanel Margin="30,32,30,0">
            <TextBlock Name="TitleText" FontSize="16" FontWeight="Bold" Text="Uninstall Update" />
            <TextBlock Name="ToStartText" FontSize="13" TextWrapping="Wrap" Margin="0,14,0,32" Text="To start using this Playbook. This update causes issues with the system and should be uninstalled." />
            <Grid Name="StepsProgressContainer">
                <Grid.RowDefinitions>
                    <RowDefinition Height="182" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <StackPanel Name="Steps">
                    <controls:TextListItem Margin="0,9,0,0" Prefix="1.     " FontSize="13" TextWrapping="Wrap" MaxWidth="380" HorizontalAlignment="Left">
                        <controls:TextListItem.Inlines>
                            <Run FontSize="13" Text="Click the button below to begin uninstallation." />
                        </controls:TextListItem.Inlines>
                    </controls:TextListItem>
                    <TextBlock />
                    <StackPanel Margin="5,-1,0,0" Orientation="Horizontal">
                        <TextBlock Text="       " />
                        <Button Name="UninstallButton" Style="{DynamicResource ContentBoxButton}" Click="UninstallClicked">
                            <TextBlock VerticalAlignment="Center" FontSize="14" Margin="0,0,0,1" Text="Uninstall Update" />
                        </Button>
                        <Button Name="BypassButton" Height="32" Margin="8,0,0,-6" Padding="11,4,11,4" Style="{DynamicResource TransparentButton}" Click="BypassButton_OnClick">
                            <TextBlock VerticalAlignment="Center" FontSize="14" Margin="0,0,0,1" Text="Bypass" Foreground="{DynamicResource TransparentButtonTextForeground}" />
                        </Button>
                    </StackPanel>
                    <TextBlock />
                    <controls:TextListItem x:Name="Step2" Margin="0,10,0,0" FontSize="13" Prefix="2.     " TextWrapping="Wrap" Width="340" HorizontalAlignment="Left">
                        <controls:TextListItem.Inlines>
                            <Run FontSize="13" Text="When prompted to uninstall the update, click " />
                            <Run FontSize="13" FontWeight="Bold" Text="Yes " />
                            <Run FontSize="13" Text="and follow further instructions here." />
                        </controls:TextListItem.Inlines>
                    </controls:TextListItem>
                </StackPanel>
                <Grid Row="1" Margin="1,0,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="73" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid Width="57" Height="50" HorizontalAlignment="Left">
                        <Image Name="SoftwareIcon" Style="{DynamicResource QualityImage}" Source="/Icons/features_blue_gradient_128.png" Width="47" HorizontalAlignment="Left" VerticalAlignment="Top" />
                        <Image Name="CheckmarkIcon" Style="{DynamicResource QualityImage}" Source="/Icons/checkmark_green_gradient_32.png" Visibility="Hidden" Height="21" HorizontalAlignment="Right" VerticalAlignment="Bottom" />
                    </Grid>
                    <StackPanel Grid.Column="1" HorizontalAlignment="Left">
                        <TextBlock Name="StatusText" FontWeight="Bold" Margin="0,4,0,3" FontSize="15" Text="Monitoring update state..." />
                        <controls:ProgressBarIndeterminate x:Name="ProgressBar" Width="292" HorizontalAlignment="Left" />
                        <TextBlock Name="FinishText" Visibility="Collapsed" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,-1,0,0" Text="Restart at the soonest possible time" />
                    </StackPanel>
                </Grid>
            </Grid>
        </StackPanel>
    </Grid>
</Grid>