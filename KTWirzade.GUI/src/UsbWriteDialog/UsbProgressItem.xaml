<UserControl x:Class="KTWirzade.GUI.UsbWriteDialog.UsbProgressItem"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:KTWirzade.GUI.UsbWriteDialog"
             xmlns:controls="clr-namespace:KTWirzade.GUI.Controls"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">
    
    <StackPanel Name="MainStack" Orientation="Horizontal">
        <Grid VerticalAlignment="Top" HorizontalAlignment="Left" Margin="0,8,0,0">
            <Image Name="UsbImage" Source="/Icons/usb_blank.png" Style="{StaticResource QualityImage}" Width="20" />
            <Image Name="CheckImage" Source="/Icons/checkmark_green_gradient_64.png" Style="{StaticResource QualityImage}" Width="20" Visibility="Collapsed" />
            <Image Name="FailedImage" Source="/Icons/warning_circle_yellow_gradient_64.png" Style="{StaticResource QualityImage}" Width="20" Visibility="Collapsed" />
        </Grid>
        <StackPanel Margin="12,0,0,0" VerticalAlignment="Top">
            <TextBlock Name="StatusText" FontWeight="Bold" Margin="0,0,0,3" FontSize="15" Text="Writing to USB..." />
            <controls:ProgressBarDeterminate x:Name="ProgressBar" Width="253" Maximum="100" HorizontalAlignment="Left" CornerRadius="2" />
            <TextBlock Name="FinishText" Visibility="Hidden" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,-3,0,0" Text="Restart at the soonest possible time" />
        </StackPanel>
    </StackPanel>
</UserControl>
