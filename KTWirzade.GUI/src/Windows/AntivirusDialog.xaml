<controls:AcrylicWindow x:Class="KTWirzade.GUI.Windows.AntivirusDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:KTWirzade.GUI.Windows"
        xmlns:controls="clr-namespace:KTWirzade.GUI.Controls"
        xmlns:wpf="clr-namespace:FluentIcons.Wpf;assembly=FluentIcons.Wpf"
        mc:Ignorable="d"
        Height="584" Width="855" Style="{DynamicResource Window}" 
        WindowStartupLocation="CenterOwner"
        RenderTransformOrigin="0.5,0.5" 
        Title="Disable Antivirus" 
        CornerType="Round" 
        MaxWidth="{Binding Source={x:Static SystemParameters.WorkArea}, Path=Width}" 
        MaxHeight="{Binding Source={x:Static SystemParameters.WorkArea}, Path=Height}">

    <UIElement.RenderTransform>
        <TransformGroup>
            <ScaleTransform CenterX="100" x:Name="securityscale" />
        </TransformGroup>
    </UIElement.RenderTransform>
    <Grid Name="RootWindow">
        <Grid.RowDefinitions>
            <RowDefinition Height="40" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Rectangle Grid.RowSpan="2" Fill="{DynamicResource PrimaryBrush}" Margin="0,0,0,0">
            <UIElement.Clip>
                <CombinedGeometry GeometryCombineMode="Exclude">
                    <CombinedGeometry.Geometry1>
                        <RectangleGeometry Rect="0,0,1000,1000" />
                    </CombinedGeometry.Geometry1>
                    <CombinedGeometry.Geometry2>
                        <RectangleGeometry RadiusX="8" RadiusY="8" Rect="395.5,40.5,1000,500" />
                    </CombinedGeometry.Geometry2>
                </CombinedGeometry>
            </UIElement.Clip>
        </Rectangle>
        <DockPanel Name="TitleBar" Dock="Top" Height="40" VerticalAlignment="Top">
            <Image Style="{StaticResource QualityImage}" Margin="8, 6,0,0" VerticalAlignment="Top" Source="/Icons/ICO.ico" Width="21" Height="21" />
            <Button Name="CloseButton" Style="{DynamicResource CloseButton}" Padding="0,0,0,50" Visibility="Visible" IsEnabled="True" DockPanel.Dock="Right" VerticalAlignment="Top" Click="CloseButton_Click" />
            <TextBlock Name="TitleSpace" VerticalAlignment="Top" Margin="7,0,0,0" Padding="0,11,0,9" FontSize="12" LineStackingStrategy="BlockLineHeight" LineHeight="12" Width="770" Text="Disable Antivirus" Height="25" MouseLeftButtonDown="TitleBar_MouseDown" />
        </DockPanel>
        <Grid Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="395" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Grid Name="LeftContainer" VerticalAlignment="Top" Margin="0,80,0,0" UseLayoutRounding="True">
                <Image Name="SettingsApps" Source="{DynamicResource SettingsAppsBitmap}" Style="{DynamicResource QualityImage}" Width="313" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <UIElement.Effect>
                        <DropShadowEffect BlurRadius="18" Opacity="0.45" ShadowDepth="0" />
                    </UIElement.Effect>
                </Image>
                <Border Name="AppsScrollBar" Background="{DynamicResource SettingsAppsScrollBarBrush}" CornerRadius="1,1,1,1" Width="1" Height="55" Margin="0,51,43,0" HorizontalAlignment="Right" VerticalAlignment="Top" />
                <Grid Margin="156,44,0,0" Height="298" VerticalAlignment="Top" ClipToBounds="True">
                    <StackPanel Name="Scroller" Margin="0,0,0,0">
                        <Image Name="SettingsAppsHeader" Style="{DynamicResource QualityImage}" Margin="0,0,0,0" Width="187" Source="{DynamicResource SettingsAppsHeaderBitmap}" VerticalAlignment="Top" HorizontalAlignment="Left" Visibility="Visible" />
                        <Image Name="SettingsAppsList" Margin="1,0,0,0" Style="{DynamicResource QualityImage}" Width="187" Source="{DynamicResource SettingsAppsListBitmap}" VerticalAlignment="Top" HorizontalAlignment="Left" Visibility="Visible" />
                    </StackPanel>
                </Grid>
                <Border Name="DotsHoverEffect" Width="12" Height="17" VerticalAlignment="Top" HorizontalAlignment="Right" Margin="0,249,60,0" Opacity="0" CornerRadius="1.5">
                    <Border.Background>
                        <SolidColorBrush Color="{DynamicResource ButtonTextPrimaryColor}" Opacity="0.05" />
                    </Border.Background>
                </Border>
                <Border Name="AppsModifyShadowBorder" Margin="0,268,58,0" Width="113" VerticalAlignment="Top" HorizontalAlignment="Right" Height="29">
                    <UIElement.Effect>
                        <DropShadowEffect BlurRadius="10" Opacity="0" Direction="270" />
                    </UIElement.Effect>
                    <Grid ClipToBounds="True">
                        <Image Name="SettingsAppsModifyBox" Width="113" Margin="0,-20,0,0" Style="{DynamicResource QualityImage}" Opacity="0" HorizontalAlignment="Right" Source="{DynamicResource SettingsAppsModifyBoxBitmap}" VerticalAlignment="Top" Visibility="Visible" />
                        <Border Name="UninstallHoverEffect" Opacity="0" Height="12" Width="107" VerticalAlignment="Top" Margin="0,15,0,0" CornerRadius="2,2,2,2">
                            <Border.Background>
                                <SolidColorBrush Color="{DynamicResource ButtonTextPrimaryColor}" Opacity="0.05" />
                            </Border.Background>
                        </Border>
                    </Grid>
                </Border>
                <Border Name="AppsUninstallShadowBorder" Margin="0,268,58,0" Width="126" VerticalAlignment="Top" HorizontalAlignment="Right" Height="49">
                    <UIElement.Effect>
                        <DropShadowEffect BlurRadius="10" Opacity="0" Direction="270" />
                    </UIElement.Effect>
                    <Grid ClipToBounds="True">
                        <Image Name="SettingsAppsUninstallBox" Width="126" Margin="0,-20,0,0" Style="{DynamicResource QualityImage}" HorizontalAlignment="Right" Opacity="0" Source="{DynamicResource SettingsAppsUninstallBoxBitmap}" VerticalAlignment="Top" Visibility="Visible" />
                        <Border Name="UninstallButtonHoverEffect" Opacity="0" Height="13" Width="37" VerticalAlignment="Top" Margin="74,28,0,0" CornerRadius="2,2,2,2">
                            <Border.Background>
                                <SolidColorBrush Color="{DynamicResource ButtonTextPrimaryColor}" Opacity="0.03" />
                            </Border.Background>
                        </Border>
                    </Grid>
                </Border>
                <Image Name="MouseCursor" Style="{DynamicResource QualityImage}" Width="5" Source="{StaticResource MouseCursorBitmap}" VerticalAlignment="Top" HorizontalAlignment="Left" Visibility="Visible" Margin="276,257,0,0" />
            </Grid>
            <Grid Column="1" Height="501" VerticalAlignment="Top">
                <Border Background="{DynamicResource PageBackground}" CornerRadius="9,0,0,9" />
                <Border Name="PageContainer" BorderBrush="{DynamicResource PageBorderBrush}" BorderThickness="1,1,0,1" Background="#00FFFFFF" CornerRadius="8,0,0,8" Padding="29,31,29,0">
                    <StackPanel HorizontalAlignment="Left" VerticalAlignment="Top">
                        <TextBlock FontSize="16" FontWeight="Bold" Text="Disable 3rd Party Antivirus" />
                        <TextBlock Name="ToStartText" FontSize="13" TextWrapping="Wrap" Margin="0,14,0,22" />
                        <Grid Name="ModuleGrid" Margin="0,-96,0,0" Opacity="0">
                            <TextBlock />
                            <StackPanel Name="RemnantGrid" Visibility="Hidden" RenderTransformOrigin="0.5,0.5">
                                <UIElement.RenderTransform>
                                    <TransformGroup>
                                        <ScaleTransform CenterX="100" x:Name="remnanttransform" />
                                    </TransformGroup>
                                </UIElement.RenderTransform>
                                <controls:TextListItem Prefix="1.     " PrefixVisibility="Hidden" FontSize="13" MaxWidth="380" HorizontalAlignment="Left">
                                    <controls:TextListItem.Inlines>
                                        <Run FontSize="13" Text="It looks like there are remnants of AV software still present&#xD;&#xA;after its removal. Would you like to " />
                                        <Run FontSize="13" FontWeight="Bold" Text="remove" />
                                        <Run FontSize="13" Text=" the remnants?" />
                                    </controls:TextListItem.Inlines>
                                </controls:TextListItem>
                                <TextBlock />
                                <StackPanel Margin="5,-1,0,0" Orientation="Horizontal">
                                    <TextBlock Text="       " />
                                    <Button Name="RemnantButton" Style="{DynamicResource ContentBoxButton}" Click="RemnantButton_OnClick">
                                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Orientation="Horizontal">
                                            <TextBlock VerticalAlignment="Center" HorizontalAlignment="Center" FontSize="14" Margin="0,0,0,1" Text="Run action now" />
                                        </StackPanel>
                                    </Button>
                                    <Grid Name="LoadContainer" Margin="8,0,0,0" Visibility="Collapsed" Width="16" Height="16" />
                                    <Button Name="ImGoodButton" Height="32" Margin="8,0,0,-6" Padding="11,4,11,4" Style="{DynamicResource TransparentButton}" Click="ImGoodButton_OnClick">
                                        <TextBlock Name="ImGoodText" VerticalAlignment="Center" FontSize="14" Margin="0,0,0,1" Text="No, I'm good" Foreground="{DynamicResource TransparentButtonTextForeground}" />
                                    </Button>
                                </StackPanel>
                                <TextBlock />
                            </StackPanel>
                        </Grid>
                        <StackPanel Name="Steps">
                            <controls:TextListItem Margin="0,9,0,0" Prefix="1.     " FontSize="13" TextWrapping="Wrap" MaxWidth="380" HorizontalAlignment="Left">
                                <controls:TextListItem.Inlines>
                                    <Run FontSize="13" Text="Click the button below or open " />
                                    <Run FontSize="13" FontWeight="Bold" Text="Windows Settings " />
                                    <Run FontWeight="Bold" FontSize="8" Text="▶" BaselineAlignment="Center" />
                                    <Run FontSize="13" FontWeight="Bold" Text="&#xD;&#xA;Apps " />
                                    <Run FontWeight="Bold" FontSize="8" Text="▶" BaselineAlignment="Center" />
                                    <Run FontSize="13" FontWeight="Bold" Text=" Installed apps" />
                                    <Run FontSize="13" Text=", and then " />
                                    <Run FontSize="13" FontWeight="Bold" Text="find your Antivirus app" />
                                    <Run FontSize="13" Text="." />
                                </controls:TextListItem.Inlines>
                            </controls:TextListItem>
                            <TextBlock />
                            <StackPanel Margin="5,-1,0,0" Orientation="Horizontal">
                                <TextBlock Text="       " />
                                <Button Name="OpenAntivirusButton" Style="{DynamicResource ContentBoxButton}" Click="OpenAntivirus">
                                    <TextBlock VerticalAlignment="Center" FontSize="14" Margin="0,0,0,1" Text="Open Installed apps" />
                                </Button>
                                <Button Name="UninstallerButton" Height="32" Visibility="Hidden" Margin="8,0,0,-6" Padding="11,4,11,4" Style="{DynamicResource TransparentButton}" Click="UninstallerButton_OnClick">
                                    <TextBlock VerticalAlignment="Center" FontSize="14" Margin="0,0,0,1" Text="Run Uninstaller" Foreground="{DynamicResource TransparentButtonTextForeground}" />
                                </Button>
                            </StackPanel>
                            <TextBlock />
                            <controls:TextListItem x:Name="Step2" Margin="0,9,0,0" FontSize="13" Prefix="2.     " TextWrapping="Wrap" Width="340" HorizontalAlignment="Left">
                                <controls:TextListItem.Inlines>
                                    <Run FontSize="13" Text="Uninstall Antivirus software and reboot the system." />
                                </controls:TextListItem.Inlines>
                            </controls:TextListItem>
                        </StackPanel>
                        <Grid Margin="3,53,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="70" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid Width="49" Height="49" HorizontalAlignment="Left">
                                <Image Style="{DynamicResource QualityImage}" Source="/Icons/shield_blue_gradient_64.png" Width="44" Height="47" HorizontalAlignment="Left" VerticalAlignment="Top" />
                                <Image Name="CheckMark" Style="{DynamicResource QualityImage}" Source="/Icons/checkmark_green_gradient_32.png" Visibility="Visible" Height="21" HorizontalAlignment="Right" VerticalAlignment="Bottom" />
                            </Grid>
                            <StackPanel Grid.Column="1" HorizontalAlignment="Left">
                                <TextBlock Name="StatusText" FontWeight="Bold" Margin="0,4,0,3" FontSize="15" Text="Checking Antivirus signature..." />
                                <controls:ProgressBarIndeterminate x:Name="ProgressBar" Width="292" HorizontalAlignment="Left" />
                                <TextBlock Name="FinishText" Visibility="Collapsed" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,-1,0,0" Text="Restart at the soonest possible time" />
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Border>
            </Grid>
        </Grid>
    </Grid>
</controls:AcrylicWindow>