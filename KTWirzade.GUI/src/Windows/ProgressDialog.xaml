<controls:AcrylicWindow x:Class="KTWirzade.GUI.Windows.ProgressDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:KTWirzade.GUI.Windows"
        xmlns:controls="clr-namespace:KTWirzade.GUI.Controls"
        xmlns:wpf="clr-namespace:FluentIcons.Wpf;assembly=FluentIcons.Wpf"
        xmlns:gui="clr-namespace:KTWirzade.GUI"
        mc:Ignorable="d"
        Height="584" Width="855" Style="{DynamicResource Window}" 
        WindowStartupLocation="CenterOwner"
        RenderTransformOrigin="0.5,0.5" 
        Title="Apply Playbook" CornerType="Round" Topmost="True" 
        MaxWidth="{Binding Source={x:Static SystemParameters.WorkArea}, Path=Width}" 
        MaxHeight="{Binding Source={x:Static SystemParameters.WorkArea}, Path=Height}">

    <UIElement.RenderTransform>
        <TransformGroup>
            <ScaleTransform CenterX="100" x:Name="progressscale" />
        </TransformGroup>
    </UIElement.RenderTransform>
    <Grid Name="RootWindow">
        <Grid.RowDefinitions>
            <RowDefinition Height="40" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Rectangle Grid.RowSpan="2" Fill="{DynamicResource PrimaryBrush}" Margin="0,0,0,0">
            <UIElement.Clip>
                <CombinedGeometry GeometryCombineMode="Exclude">
                    <CombinedGeometry.Geometry1>
                        <RectangleGeometry Rect="0,0,1000,1000" />
                    </CombinedGeometry.Geometry1>
                    <CombinedGeometry.Geometry2>
                        <RectangleGeometry RadiusX="8" RadiusY="8" Rect="395.5,40.5,1000,500" />
                    </CombinedGeometry.Geometry2>
                </CombinedGeometry>
            </UIElement.Clip>
        </Rectangle>
        <DockPanel Name="TitleBar" Dock="Top" Height="40" VerticalAlignment="Top">
            <Image Style="{StaticResource QualityImage}" Margin="8, 6,0,0" VerticalAlignment="Top" Source="/Icons/ICO.ico" Width="21" Height="21" />
            <Button Name="CloseButton" Style="{DynamicResource CloseButton}" Padding="0,0,0,50" Visibility="Visible" IsEnabled="False" DockPanel.Dock="Right" VerticalAlignment="Top" Click="CloseButton_Click" />
            <TextBlock Name="TitleSpace" VerticalAlignment="Top" Margin="7,0,0,0" Padding="0,11,0,9" FontSize="12" LineStackingStrategy="BlockLineHeight" HorizontalAlignment="Left" LineHeight="12" Text="Apply Playbook" Width="770" TextTrimming="CharacterEllipsis" Height="25" DataContext="{Binding Source={x:Static gui:GlobalsGUI.Current}}" MouseLeftButtonDown="TitleBar_MouseDown" />
        </DockPanel>
        <Grid Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="395" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Grid VerticalAlignment="Center" Margin="0,-40,0,0">
                <Image Source="/Icons/code_blue_gradient_256.png" Style="{DynamicResource QualityImage}" Width="248" HorizontalAlignment="Center" VerticalAlignment="Center" />
                <Image Name="StatusImage" Source="/Icons/checkmark_green_gradient_128.png" Width="100" Visibility="Hidden" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,36,-21">
                    <UIElement.Effect>
                        <DropShadowEffect Opacity="0.4" BlurRadius="20" ShadowDepth="0" />
                    </UIElement.Effect>
                </Image>
            </Grid>
            <Grid Column="1" Height="501" VerticalAlignment="Top">
                <Border Background="{DynamicResource PageBackground}" CornerRadius="9,0,0,9" />
                <Border Name="PageContainer" BorderBrush="{DynamicResource PageBorderBrush}" BorderThickness="1,1,0,1" Background="#00FFFFFF" CornerRadius="8,0,0,8" Padding="29,31,29,0">
                    <Grid>
                        <StackPanel HorizontalAlignment="Left" VerticalAlignment="Top">
                            <TextBlock Name="PageTitleText" FontSize="16" FontWeight="Bold" Text="Apply Playbook" MaxWidth="305" HorizontalAlignment="Left" VerticalAlignment="Top" DataContext="{Binding Source={x:Static gui:GlobalsGUI.Current}}" />
                            <TextBlock FontSize="13" Width="350" HorizontalAlignment="Left" TextWrapping="Wrap" Margin="0,14,0,0" DataContext="{Binding Source={x:Static gui:GlobalsGUI.Current}}" Text="{Binding Playbook.ProgressText}" />
                            <Grid Name="ProgressGrid">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Margin="0,109,0,0" Grid.Column="0" HorizontalAlignment="Left">
                                    <TextBlock Name="StatusText" FontWeight="Bold" Margin="0,2,0,3" FontSize="15" Text="Extracting Playbook..." Width="230" HorizontalAlignment="Left" TextTrimming="CharacterEllipsis" />
                                    <controls:ProgressBarDeterminate x:Name="ProgressBar" Width="362" HorizontalAlignment="Left" />
                                    <TextBlock Name="FinishText" Visibility="Collapsed" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,-2,0,0" Text="Restart at the soonest possible time" Width="230" TextTrimming="CharacterEllipsis" HorizontalAlignment="Left" />
                                </StackPanel>
                                <Button Name="ShowLogsButton" Grid.Column="1" Style="{DynamicResource ContentBoxButton}" Margin="10,0,0,0" HorizontalAlignment="Right" Visibility="Collapsed" VerticalAlignment="Bottom" Click="ShowLogs_OnClick">
                                    <TextBlock FontSize="14" Margin="0,0,0,0" Text="Show logs" />
                                </Button>
                            </Grid>
                        </StackPanel>
                        <CheckBox Name="CheckBox" IsChecked="True" VerticalAlignment="Bottom" HorizontalAlignment="Right" Margin="0,0,33,24" />
                        <TextBlock Name="RestartTextCheck" VerticalAlignment="Bottom" HorizontalAlignment="Left" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="13" Width="240" TextWrapping="Wrap" Margin="-1,0,15,20" Text="The system will automatically be restarted once the process completes." />
                    </Grid>
                </Border>
            </Grid>
        </Grid>
    </Grid>
</controls:AcrylicWindow>