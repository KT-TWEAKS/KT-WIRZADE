<control:AcrylicWindow x:Class="KTWirzade.GUI.Windows.UninstallUpdatesDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:KTWirzade.GUI.Windows"
        xmlns:control="clr-namespace:KTWirzade.GUI.Controls"
        xmlns:wpf="clr-namespace:FluentIcons.Wpf;assembly=FluentIcons.Wpf"
        xmlns:tweakModules="clr-namespace:KTWirzade.GUI.UninstallUpdateDialog"
        mc:Ignorable="d"
        Height="584" Width="855" 
        Style="{DynamicResource Window}" WindowStartupLocation="CenterOwner" 
        RenderTransformOrigin="0.5,0.5" Title="Disable UninstallUpdates" 
        CornerType="Round"
        MaxWidth="{Binding Source={x:Static SystemParameters.WorkArea}, Path=Width}"
        MaxHeight="{Binding Source={x:Static SystemParameters.WorkArea}, Path=Height}">

    <UIElement.RenderTransform>
        <TransformGroup>
            <ScaleTransform CenterX="100" x:Name="securityscale" />
        </TransformGroup>
    </UIElement.RenderTransform>
    <Grid Name="RootWindow">
        <Grid.RowDefinitions>
            <RowDefinition Height="40" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Rectangle Name="FillRect" Grid.RowSpan="2" Fill="{DynamicResource PrimaryBrush}" Margin="0,0,0,0">
            <UIElement.Clip>
                <CombinedGeometry GeometryCombineMode="Exclude">
                    <CombinedGeometry.Geometry1>
                        <RectangleGeometry Rect="0,0,1000,3000" />
                    </CombinedGeometry.Geometry1>
                    <CombinedGeometry.Geometry2>
                        <GeometryGroup x:Name="ExcludeGeometries" />
                    </CombinedGeometry.Geometry2>
                </CombinedGeometry>
            </UIElement.Clip>
        </Rectangle>
        <DockPanel Name="TitleBar" Dock="Top" Height="40" VerticalAlignment="Top" ZIndex="2">
            <Image Style="{StaticResource QualityImage}" Margin="8, 6,0,0" VerticalAlignment="Top" Source="/Icons/ICO.ico" Width="21" Height="21" />
            <Button Name="CloseButton" Style="{DynamicResource CloseButton}" Padding="0,0,0,50" Visibility="Visible" IsEnabled="True" DockPanel.Dock="Right" VerticalAlignment="Top" Click="CloseButton_Click" />
            <TextBlock Name="TitleSpace" VerticalAlignment="Top" Margin="7,0,0,0" Padding="0,11,0,9" FontSize="12" LineStackingStrategy="BlockLineHeight" LineHeight="12" Width="770" Text="Uninstall Updates" Height="25" MouseLeftButtonDown="TitleBar_MouseDown" />
        </DockPanel>
        <StackPanel Name="UninstallUpdateStack" Grid.RowSpan="2" Margin="0,40,0,0" RenderTransformOrigin="0.5,0.5">
            <UIElement.RenderTransform>
                <TranslateTransform x:Name="StackTransform" />
            </UIElement.RenderTransform>
        </StackPanel>
        <Button Name="SwitchPageButton" Grid.Row="1" IsHitTestVisible="False" Opacity="0" Margin="0,392,185,0" Padding="9,0,13,0" Style="{DynamicResource ContentBoxButton}" HorizontalAlignment="Right" RenderTransformOrigin="0.5,0.5" Click="SwitchPageButton_OnClick">
            <UIElement.RenderTransform>
                <TransformGroup>
                    <ScaleTransform x:Name="ContinueScaleTransform" />
                    <TranslateTransform x:Name="ContinueTranslateTransform" />
                </TransformGroup>
            </UIElement.RenderTransform>
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Orientation="Horizontal">
                <wpf:SymbolIcon TextBlock.Foreground="{DynamicResource TextPrimaryBrush}" wpf:SymbolIcon.Symbol="ArrowSquareDown" TextBlock.FontSize="20" FrameworkElement.Margin="0,0,7,0" />
                <TextBlock VerticalAlignment="Center" HorizontalAlignment="Center" FontSize="14" Margin="0,-1,0,1" Text="Continue" />
            </StackPanel>
        </Button>
    </Grid>
</control:AcrylicWindow>