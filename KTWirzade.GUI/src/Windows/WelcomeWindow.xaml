<controls:AcrylicWindow x:Class="KTWirzade.GUI.Windows.WelcomeWindow"
                        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                        xmlns:controls="clr-namespace:KTWirzade.GUI.Controls"
                         xmlns:wpf="clr-namespace:FluentIcons.Wpf;assembly=FluentIcons.Wpf"
                          mc:Ignorable="d" Title="KT WIRZADE" Height="520" Width="400" Style="{DynamicResource Window}"
                         WindowStartupLocation="CenterScreen" ResizeMode="NoResize" Icon="/Icons/ico.ico"
                        d:DesignHeight="580" d:DesignWidth="420">

    <DockPanel Name="RootWindow" Background="{DynamicResource AboutBrush}">
        <DockPanel Name="TitleBar" Dock="Top" MaxHeight="36" Background="Transparent">
            <Button Name="CloseButton" Style="{DynamicResource CloseButton}" Padding="0,0,0,36" DockPanel.Dock="Right" HorizontalAlignment="Right" VerticalAlignment="Top" Click="CloseButton_Click" />
            <Image Style="{StaticResource QualityImage}" Margin="7,7,0,0" VerticalAlignment="Top" Source="/Icons/ICO.ico" Width="16" Height="16" />
            <TextBlock VerticalAlignment="Top" Margin="7,0,0,0" Padding="0,9.5,0,5" FontSize="12" LineStackingStrategy="BlockLineHeight" LineHeight="12" Text="KT WIRZADE" Height="25" Foreground="{DynamicResource TextPrimaryBrush}" MouseLeftButtonDown="TitleBar_MouseDown" />
        </DockPanel>

        <Grid Margin="30,0,30,28">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" Margin="0,8,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Border Grid.Column="1" Width="116" Height="116" CornerRadius="58" VerticalAlignment="Center" Background="Transparent">
                    <Border.Effect>
                        <DropShadowEffect ShadowDepth="0" BlurRadius="20" Opacity="0.35" Color="#0096c7" />
                    </Border.Effect>
                    <Ellipse Name="AvatarEllipse" Width="108" Height="108" VerticalAlignment="Center" HorizontalAlignment="Center">
                        <Ellipse.Stroke>
                            <SolidColorBrush Color="{DynamicResource ProgressBarColor}" />
                        </Ellipse.Stroke>
                        <Ellipse.StrokeThickness>2.5</Ellipse.StrokeThickness>
                        <Ellipse.Fill>
                            <SolidColorBrush Color="{DynamicResource TextPrimaryColor}" Opacity="0.08" />
                        </Ellipse.Fill>
                    </Ellipse>
                </Border>
            </Grid>

            <StackPanel Grid.Row="1" Margin="0,14,0,0">
                <TextBlock FontSize="26" FontWeight="Bold" Text="KT WIRZADE" HorizontalAlignment="Center" Foreground="{DynamicResource TextPrimaryBrush}" />
                <TextBlock Name="VersionText" HorizontalAlignment="Center" Text="v1.0.0" FontSize="13" Margin="0,5,0,0" Foreground="{DynamicResource TextSecondaryBrush}" />
            </StackPanel>

            <Border Grid.Row="2" Margin="0,16,0,0" Height="1" HorizontalAlignment="Stretch" Opacity="0.15">
                <Border.Background>
                    <SolidColorBrush Color="{DynamicResource TextPrimaryColor}" />
                </Border.Background>
            </Border>

            <TextBlock Grid.Row="3" Margin="0,14,0,0" TextAlignment="Center" FontSize="14" Foreground="{DynamicResource TextPrimaryBrush}" TextWrapping="Wrap" LineHeight="22">
                Uma versão customizada e melhorada do
            </TextBlock>
            <TextBlock Grid.Row="4" Margin="0,3,0,0" TextAlignment="Center" FontSize="17" FontWeight="Bold" Foreground="{DynamicResource ProgressBarBrush}" TextWrapping="Wrap">
                AME Wizard
            </TextBlock>
            <TextBlock Grid.Row="5" Margin="0,6,0,0" TextAlignment="Center" FontSize="13" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" LineHeight="20">
                Com interface traduzida, correções de estabilidade,<LineBreak/>e novos recursos para melhor experiência.
            </TextBlock>

            <Border Grid.Row="6" Margin="0,18,0,0" CornerRadius="8" Padding="18,14" Background="{DynamicResource FakeBackgroundBrush}" BorderThickness="1" BorderBrush="{DynamicResource ContentBoxBorderBrush}">
                <StackPanel>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                        <wpf:SymbolIcon wpf:SymbolIcon.Symbol="Person" TextBlock.Foreground="{DynamicResource ProgressBarBrush}" TextBlock.FontSize="16" Margin="0,0,8,0" />
                        <TextBlock FontWeight="SemiBold" FontSize="14" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center">
                            kelvenapk
                        </TextBlock>
                    </StackPanel>
                    <TextBlock FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" HorizontalAlignment="Center" Margin="0,6,0,0">
                        github.com/kelvenapk
                    </TextBlock>
                </StackPanel>
            </Border>

            <StackPanel Grid.Row="8" Margin="0,0,0,0" HorizontalAlignment="Center">
                <Button Name="ContinueButton" Width="200" Height="40" Style="{DynamicResource BlueButton}" Click="ContinueButton_Click">
                    <StackPanel Orientation="Horizontal">
                        <wpf:SymbolIcon wpf:SymbolIcon.Symbol="ArrowRight" TextBlock.Foreground="White" TextBlock.FontSize="16" Margin="0,0,8,0" />
                        <TextBlock Text="Continuar" FontSize="14" FontWeight="SemiBold" Foreground="White" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>

                <Button Name="GitHubButton" Width="200" Height="34" Margin="0,10,0,0" Style="{DynamicResource TopButtonOpaque}" Click="GitHubButton_Click">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                        <wpf:SymbolIcon wpf:SymbolIcon.Symbol="Globe" TextBlock.Foreground="{DynamicResource TextPrimaryBrush}" TextBlock.FontSize="16" />
                        <TextBlock FontSize="12" Text="GitHub" Margin="8,2,0,0" Foreground="{DynamicResource TextPrimaryBrush}" />
                    </StackPanel>
                </Button>
            </StackPanel>
        </Grid>
    </DockPanel>
</controls:AcrylicWindow>
