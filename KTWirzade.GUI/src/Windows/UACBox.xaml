<Window x:Class="KTWirzade.GUI.Windows.UACBox"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:KTWirzade.GUI.Windows"
        mc:Ignorable="d"
        Title="FakeUAC"
        WindowStartupLocation="CenterScreen" 
        Topmost="True" 
        SizeToContent="Height" MinHeight="398" Width="456" 
        WindowStyle="None" ResizeMode="NoResize" BorderThickness="1" BorderBrush="#4A5459" 
        Style="{DynamicResource WindowBackgroundWPF}" AllowsTransparency="True" 
        RenderTransformOrigin="0.5,0.5" 
        Activated="Window_Activated" Closing="Window_Closing">
    <UIElement.RenderTransform>
        <TransformGroup>
            <ScaleTransform CenterX="100" x:Name="UACScale" />
        </TransformGroup>
    </UIElement.RenderTransform>
    <DockPanel Name="RootWindow">
        <DockPanel Name="TitleBarHead" Dock="Top" Background="#76b9ed">
            <Button Name="CloseButton" Style="{DynamicResource CloseButton}" DockPanel.Dock="Right" Click="CloseButton_Click" />
            <TextBlock Name="TitleText" HorizontalAlignment="Left" Padding="23,6,0,6" TextAlignment="Left" Text="BoxTitle" Foreground="#FF000000" />
        </DockPanel>
        <DockPanel Name="CustomTitleBar" Dock="Top">
            <TextBlock Name="TBCaption" TextAlignment="Left" Padding="23,3,20,10" DockPanel.Dock="Top" Background="#76b9ed" Foreground="#FF000000" FontSize="20" TextWrapping="Wrap" Text="BoxCaption" />
            <DockPanel Name="TitleBarCaption" Dock="Bottom">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <Grid Name="MainGrid" Margin="23">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="0.5*" />
                            <ColumnDefinition Width="1.5*" />
                            <ColumnDefinition Width="2*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="auto" />
                            <RowDefinition Height="20" />
                            <RowDefinition Height="auto" />
                            <RowDefinition Height="3*" />
                            <RowDefinition Height="auto" />
                            <RowDefinition Height="4*" />
                            <RowDefinition Height="35" />
                        </Grid.RowDefinitions>
                        <Image Name="IconProgram" Width="45" Height="45" Stretch="Uniform" />
                        <TextBlock Name="TBProgamName" VerticalAlignment="Center" Grid.Column="1" Grid.ColumnSpan="2" Margin="6" TextWrapping="Wrap" Text="TBProgamName" FontSize="17" Style="{DynamicResource Headers}" />
                        <TextBlock Name="TBDescription1" Grid.Row="2" Grid.ColumnSpan="3" VerticalAlignment="Center" TextWrapping="Wrap" Text="TBDescription1" FontSize="14" Margin="0,3,0,3" Style="{DynamicResource Headers}" />
                        <TextBlock Name="TBDescription2" Grid.Row="4" Grid.ColumnSpan="3" VerticalAlignment="Center" TextWrapping="Wrap" Text="TBDescription2" FontSize="14" Margin="0,3,0,3" Style="{DynamicResource Headers}" />
                        <Button Name="btnYes" Grid.Column="0" Grid.Row="6" Grid.ColumnSpan="2" Style="{DynamicResource YesNoButton}" Content="Yes" Click="ResultButton_Click" />
                        <Button Name="btnNo" Grid.Column="2" Grid.Row="6" Style="{DynamicResource YesNoButton}" Content="No" Click="ResultButton_Click" />
                    </Grid>
                </ScrollViewer>
            </DockPanel>
        </DockPanel>
    </DockPanel>
</Window>