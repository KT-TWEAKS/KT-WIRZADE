<controls:AcrylicWindow x:Class="KTWirzade.GUI.Windows.AboutWindow"
                        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                        xmlns:local="clr-namespace:KTWirzade.GUI.Windows"
                        xmlns:controls="clr-namespace:KTWirzade.GUI.Controls"
                        xmlns:wpf="clr-namespace:FluentIcons.Wpf;assembly=FluentIcons.Wpf"
                        mc:Ignorable="d" Title="Sobre o KT WIRZADE" Height="460" Width="360" MinHeight="420" MinWidth="340" Style="{DynamicResource Window}"
                        Resizable="True" ResizeMode="CanResize"
                        WindowStartupLocation="CenterOwner" RenderTransformOrigin="0.5,0.5"
                        d:DesignHeight="460" d:DesignWidth="360">

    <UIElement.RenderTransform>
        <TransformGroup>
            <ScaleTransform CenterX="0" x:Name="aboutscale" />
       </TransformGroup>
   </UIElement.RenderTransform>
    <DockPanel Name="RootWindow" Background="{DynamicResource AboutBrush}">
        <DockPanel Name="TitleBar" Dock="Top" MaxHeight="36">
            <Image Style="{StaticResource QualityImage}" Margin="7, 7,0,0" VerticalAlignment="Top" Source="/Icons/ICO.ico" Width="16" Height="16" />
            <Button Name="CloseButton" Style="{DynamicResource CloseButton}" Padding="0,0,0,36" Visibility="Visible" IsEnabled="True" DockPanel.Dock="Right" HorizontalAlignment="Right" VerticalAlignment="Top" Click="CloseButton_Click" />
            <TextBlock Name="TitleSpace" VerticalAlignment="Top" Margin="7,0,0,0" Padding="0,9.5,0,5" FontSize="12" LineStackingStrategy="BlockLineHeight" LineHeight="12" Text="Sobre" Height="25" MouseLeftButtonDown="TitleBar_MouseDown" />
       </DockPanel>
        <Grid Margin="20,0,20,16">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
           </Grid.RowDefinitions>

            <Image Grid.Row="0" Style="{DynamicResource QualityImage}" Source="{DynamicResource KTWirzadeLogo}" VerticalAlignment="Center" Height="72" Margin="0,8,0,0" />

            <StackPanel Grid.Row="1" Margin="0,12,0,0">
                <TextBlock FontSize="18" FontWeight="Bold" Text="KT WIRZADE" HorizontalAlignment="Center" Foreground="{DynamicResource TextPrimaryBrush}" />
                <TextBlock Name="VersionText" HorizontalAlignment="Center" Text="v1.0.0" FontSize="12" Margin="0,4,0,0" Foreground="{DynamicResource TextSecondaryBrush}" />
                <TextBlock Name="OsInfoText" HorizontalAlignment="Center" FontSize="10.5" Margin="0,2,0,0" Foreground="{DynamicResource TextSecondaryBrush}" Opacity="0.8" />
            </StackPanel>

            <Border Grid.Row="2" Margin="0,14,0,0" Height="1" HorizontalAlignment="Stretch" Opacity="0.12">
                <Border.Background>
                    <SolidColorBrush Color="{DynamicResource TextPrimaryColor}" />
                </Border.Background>
            </Border>

            <Border Grid.Row="3" Margin="0,12,0,0" CornerRadius="6" Padding="14,10" Background="{DynamicResource NoticeBoxBrush}" BorderThickness="1" BorderBrush="{DynamicResource ContentBoxBorderBrush}">
                <TextBlock TextWrapping="Wrap" TextAlignment="Center" HorizontalAlignment="Center" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" LineHeight="18">
                    Sistema de otimizacao e personalizacao do Windows baseado em playbooks, com privilegios de TrustedInstaller.
                </TextBlock>
            </Border>

            <Border Grid.Row="4" Margin="0,12,0,0" CornerRadius="6" Padding="14,10" Background="{DynamicResource FakeBackgroundBrush}" BorderThickness="1" BorderBrush="{DynamicResource ContentBoxBorderBrush}">
                <StackPanel>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                        <wpf:SymbolIcon wpf:SymbolIcon.Symbol="Person" TextBlock.Foreground="{DynamicResource ProgressBarBrush}" TextBlock.FontSize="14" Margin="0,0,8,0" />
                        <TextBlock FontWeight="SemiBold" FontSize="13" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center">
                            kelvenapk
                        </TextBlock>
                    </StackPanel>
                    <TextBlock FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" HorizontalAlignment="Center" Margin="0,4,0,0">
                        github.com/kelvenapk
                    </TextBlock>
                </StackPanel>
            </Border>

            <Button Grid.Row="6" Name="GitHubButton" Width="140" Height="32" Margin="0,0,0,0" Style="{DynamicResource TopButtonOpaque}" Click="WebsiteButton_OnClick" HorizontalAlignment="Center" VerticalAlignment="Bottom">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                    <wpf:SymbolIcon wpf:SymbolIcon.Symbol="Globe" TextBlock.Foreground="{DynamicResource TextPrimaryBrush}" TextBlock.FontSize="16" />
                    <TextBlock FontSize="12" Text="GitHub" Margin="8,2,0,0" Foreground="{DynamicResource TextPrimaryBrush}" />
                </StackPanel>
            </Button>
       </Grid>
    </DockPanel>
</controls:AcrylicWindow>
